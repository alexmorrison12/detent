---
/**
 * Home: the flagship narrative.
 * Night (the instrument: hero → feel → mechanism → apps) → the aperture →
 * day (craft, open, integrations, notes, offer, FAQ) → night again (closing).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { BUILD_PHASE, MODE } from '@/config/launch';
import { ogPath } from '@/config/og';
import { EDITIONS, byProfile, formatUsd } from '@/data/product';
import { absoluteUrl } from '@/lib/url';
import Instrument from '@/components/home/Instrument.astro';
import Aperture from '@/components/home/Aperture.astro';
import Craft from '@/components/home/Craft.astro';
import Open from '@/components/home/Open.astro';
import Integrations from '@/components/home/Integrations.astro';
import Proof from '@/components/home/Proof.astro';
import Offer from '@/components/home/Offer.astro';
import Faq from '@/components/home/Faq.astro';
import Closing from '@/components/home/Closing.astro';
import { EDITION_ONE, FACTS, HOME_FAQS, faqInPhase } from '@/components/home/data';

const detents = byProfile('ratchet').physics.detents;
const description = `Detent One is a machined aluminum dial with software-defined haptics: ${detents} crisp clicks in Resolve, a bump at 0 dB in Logic, a snap to every diff hunk. ${FACTS.weight}, open firmware, from ${formatUsd(EDITION_ONE.priceUsd)}.`;

const prices = EDITIONS.map((e) => e.priceUsd);
const product: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: SITE.product,
  description: SITE.description,
  image: absoluteUrl('/renders/graphite-hero.webp', Astro.site),
  brand: { '@type': 'Brand', name: SITE.name },
  manufacturer: { '@type': 'Organization', name: SITE.legalName },
  material: FACTS.material,
  sku: EDITION_ONE.sku,
  weight: { '@type': 'QuantitativeValue', value: parseInt(FACTS.weight, 10), unitCode: 'GRM' },
};
if (MODE === 'live') {
  product.offers = {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: Math.min(...prices),
    highPrice: Math.max(...prices),
    offerCount: EDITIONS.length,
    url: absoluteUrl('/shop/', Astro.site),
  };
}

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Only the questions the built page shows (see Faq.astro).
  mainEntity: HOME_FAQS.filter((f) => faqInPhase(f, BUILD_PHASE)).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout description={description} ogImage={ogPath('home')} jsonLd={[product, faqLd]}>
  <Instrument />
  <Aperture />
  <Craft />
  <Open />
  <Integrations />
  <Proof />
  <Offer />
  <Faq />
  <Closing />
</BaseLayout>
