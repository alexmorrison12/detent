---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhaseCTA from '@/components/PhaseCTA.astro';
import Protractor from '@/components/games/Protractor.astro';
import Trace from '@/components/games/Trace.astro';
import { DAILY_VARIANTS, GAMES } from '@/data/games';
import { PROFILES } from '@/data/product';
import { SITE } from '@/config/site';
import { ogPath } from '@/config/og';
import { url, absoluteUrl } from '@/lib/url';
import { dayFromIso, puzzleNumber, utcDay } from '@/scripts/games/day';
import { answerHash, seeded, shuffle } from '@/scripts/games/rng';

const epochDay = dayFromIso(GAMES.epoch);
const buildNumber = puzzleNumber(utcDay(), epochDay);

// Opaque, shuffled slots: physics + hash only. No family names reach the client.
const slots = shuffle(DAILY_VARIANTS, seeded('detent-daily-build|v1')).map((v, i) => ({
  p: v.physics,
  h: answerHash(i, v.family),
}));

const title = 'Daily Detent';
const description =
  'One hidden feel a day. Turn the dial, read the trace, and name it in five tries: Ratchet, Fluid, Spring, Clock, Wall or Magnet. New puzzle for everyone at 00:00 UTC.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Game',
    name: 'Daily Detent',
    description,
    url: absoluteUrl('/daily/', Astro.site),
    isAccessibleForFree: true,
    inLanguage: SITE.lang,
    numberOfPlayers: { '@type': 'QuantitativeValue', value: 1 },
    publisher: { '@type': 'Organization', name: SITE.legalName, url: absoluteUrl('/', Astro.site) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.product, item: absoluteUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: title, item: absoluteUrl('/daily/', Astro.site) },
    ],
  },
];

const hints = [
  {
    title: 'Torque, first quarter turn',
    note: 'The first 90° of a clockwise turn.',
    at: GAMES.daily.hintsAt[0],
    axis: ['0°', '+45°', '+90°'],
  },
  {
    title: 'Torque, full turn',
    note: 'One whole turn, −180° to +180°.',
    at: GAMES.daily.hintsAt[1],
    axis: ['−180°', '0°', '+180°'],
  },
  {
    title: 'The numbers',
    note: 'Detents, stops and spring, counted.',
    at: GAMES.daily.hintsAt[2],
    axis: [],
  },
];
const HW = 320;
const HH = 112;
---

<BaseLayout
  title={title}
  description={description}
  world="day"
  ogImage={ogPath('daily')}
  ogImageAlt="Daily Detent: name that feel"
  jsonLd={jsonLd}
>
  <daily-detent data-epoch-day={epochDay} data-slots={JSON.stringify(slots)}>
    <section class="daily container" aria-labelledby="daily-title">
      <header class="daily__intro">
        <p class="daily__no readout">
          Daily Detent <span data-daily-no>#{buildNumber}</span> · new at 00:00 UTC
        </p>
        <h1 id="daily-title" class="display display--l">
          Name that feel.
        </h1>
        <p class="daily__lede">
          One of these six is on the dial today, tuned a little off stock. Turn it, read the trace,
          name it in {GAMES.daily.tries} tries.
        </p>
        <noscript>
          <p class="daily__noscript">
            The dial needs JavaScript to turn. The six feels below still read fine without it.
          </p>
        </noscript>
      </header>

      <div class="daily__bench">
        <Protractor />
        <div class="daily__readings">
          <p class="daily__angle">
            <span class="daily__angle-label">Angle</span>{' '}
            <span class="readout" data-angle>
              ±000°
            </span>
          </p>
          <button class="btn btn--sm daily__sound" type="button" data-sound aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
              <path
                class="daily__wave"
                d="M15.2 9.2a4 4 0 0 1 0 5.6M17.8 6.6a7.6 7.6 0 0 1 0 10.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              ></path>
            </svg>
            Sound{' '}
            <span class="readout sound-state" aria-hidden="true" data-sound-state>
              off
            </span>
          </button>
        </div>
        <Trace
          class="daily__trace"
          label="Contact mic"
          reading="Still"
          caption="What a microphone on the knob would pick up. Turn the whole range, both ways, then let go."
        />
        <p class="daily__keys daily__keys--fine">
          Keyboard: focus the dial, then <kbd>←</kbd> <kbd>→</kbd> to turn.
        </p>
        <p class="daily__keys daily__keys--coarse">
          Drag the knob in a circle, or tap either side of its ring (or <span class="daily__glyph">−</span>{' '}
          and <span class="daily__glyph">+</span>) to turn it one step at a time.
        </p>
      </div>

      <div class="daily__play">
        <div class="daily__tries" data-tries aria-label="Try 1 of 5" role="img">
          {Array.from({ length: GAMES.daily.tries }, (_, i) => (
            <span class="try" data-try={i} data-state={i === 0 ? 'next' : 'open'} />
          ))}
          <span class="readout daily__try-count" aria-hidden="true" data-try-count>
            Try 1 of {GAMES.daily.tries}
          </span>
        </div>

        <h2 class="visually-hidden">Your answer</h2>
        <ul class="keys" role="list">
          {PROFILES.map((p) => (
            <li>
              <button
                class="key"
                type="button"
                data-guess={p.id}
                data-state="open"
                style={`--key-feel: var(--feel-${p.id})`}
              >
                <span class="key__name">{p.name}</span>
                <span class="key__feel">{p.feel}</span>
                <span class="key__state readout" data-guess-state />
              </button>
            </li>
          ))}
        </ul>
        <p class="daily__feedback" role="status" data-feedback></p>

        <section class="result" data-result aria-labelledby="result-title">
          <h2
            id="result-title"
            class="display display--m result__title"
            tabindex="-1"
            data-result-title
          >
            It was Ratchet.
          </h2>
          <p class="result__sub" data-result-sub></p>
          <p class="result__feel" data-result-feel></p>
          <div class="result__cut">
            <h3>Today’s cut</h3>
            <ul data-result-cut></ul>
          </div>

          <pre class="result__share readout" data-share-text></pre>
          <div class="cluster result__actions">
            <button class="btn btn--primary" type="button" data-copy>
              Copy result
            </button>
            <button class="btn" type="button" data-share hidden>
              Share
            </button>
          </div>
          <p class="result__status" role="status" data-share-status></p>

          <a
            class="btn btn--solid result__feel-link"
            href={url('/profiles/')}
            data-feel-link
            data-track="daily_feel_link"
          >
            Feel it in the library
          </a>

          <dl class="result__stats">
            <div>
              <dt>Played</dt>
              <dd class="readout" data-stat="played">
                0
              </dd>
            </div>
            <div>
              <dt>Named</dt>
              <dd class="readout" data-stat="rate">
                –
              </dd>
            </div>
            <div>
              <dt>Streak</dt>
              <dd class="readout" data-stat="streak">
                0
              </dd>
            </div>
            <div>
              <dt>Best streak</dt>
              <dd class="readout" data-stat="best-streak">
                0
              </dd>
            </div>
          </dl>
          <div class="result__meta">
            <p class="result__freeze" data-stat="freeze">
              One free freeze a week
            </p>
            <button class="btn btn--sm" type="button" data-studio-log-open>
              Studio log
            </button>
          </div>

          <figure class="dist">
            <figcaption>Named on try</figcaption>
            <ol role="list">
              {Array.from({ length: GAMES.daily.tries }, (_, i) => (
                <li class="dist__row" data-dist-row={i}>
                  <span class="dist__try readout">{i + 1}</span>
                  <span class="dist__bar" aria-hidden="true" />
                  <span class="dist__n readout" data-dist-n>
                    0
                  </span>
                </li>
              ))}
            </ol>
          </figure>

          <p class="result__next" data-countdown-line>
            Next feel in{' '}
            <time class="readout" data-countdown role="timer">
              --:--:--
            </time>
          </p>
          <p class="result__next" data-rollover hidden>
            A new feel is on the dial.{' '}
            <button class="link-arrow result__reload" type="button" data-reload>
              Load it
            </button>
          </p>
        </section>

        <section class="hints" aria-labelledby="hints-title">
          <h2 id="hints-title" class="hints__title">
            Torque hints
          </h2>
          <p class="hints__intro">
            Torque is how hard the motor pushes back at each angle. Hints appear on tries{' '}
            {hints
              .map((h) => h.at)
              .join(', ')
              .replace(/, (\d+)$/, ' and $1') + '.'}
          </p>
          <ol class="hints__list" role="list">
            {hints.map((h, i) => (
              <li class="hint" data-hint={i} data-locked="true" data-w={HW} data-h={HH}>
                <div class="hint__head">
                  <h3 class="hint__title">{h.title}</h3>
                  <p class="hint__lock readout">
                    <span class="hint__pip" aria-hidden="true" />
                    <span class="visually-hidden">Appears on </span>
                    <span class="hint__lock-try">Try</span> {h.at}
                  </p>
                </div>
                <p class="hint__note">{h.note}</p>
                {i < 2 ? (
                  <div class="hint__plot">
                    <svg
                      viewBox={`0 0 ${HW} ${HH}`}
                      preserveAspectRatio="none"
                      role="img"
                      aria-label={`${h.title}, plotted from ${h.axis[0]} to ${h.axis[2]}`}
                    >
                      <line class="hint__zero" x1="0" x2={HW} y1={HH / 2} y2={HH / 2} />
                      <g data-hint-stops />
                      <path class="hint__curve" data-hint-path d="" />
                    </svg>
                    <div class="hint__axis readout" aria-hidden="true">
                      {h.axis.map((a) => (
                        <span>{a}</span>
                      ))}
                    </div>
                  </div>
                ) : (
                  <ul class="hint__facts" data-hint-list />
                )}
              </li>
            ))}
          </ol>
        </section>
      </div>
    </section>

    <section class="after container" aria-labelledby="after-title">
      <h2 id="after-title" class="display display--m">
        Six feels. One dial. Sixty-four slots.
      </h2>
      <div class="after__body">
        <p>
          Detent One stores sixty-four profiles and switches them when you switch apps. The Daily
          Detent is how you learn to tell them apart with your eyes shut.
        </p>
        <div class="after__links">
          <a class="link-arrow" href={url('/profiles/')}>
            Browse the feel library
          </a>
          <a class="link-arrow" href={url('/crack/')}>
            Crack today’s safe
          </a>
        </div>
        <PhaseCTA placement="daily" />
      </div>
    </section>
  </daily-detent>
</BaseLayout>

<script>
  import '@/scripts/games/daily-game';
  import { captureRef } from '@/lib/waitlist';
  // Shared results link here with ?ref=; keep it so a later join credits the sharer.
  captureRef();
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest('[data-reload]')) location.reload();
  });
</script>

<style>
  daily-detent {
    display: block;
    --feel: var(--ink-strong);
  }

  .daily {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'bench' 'play';
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-2xl);
  }
  .daily__intro {
    grid-area: intro;
  }
  .daily__bench {
    grid-area: bench;
  }
  .daily__play {
    grid-area: play;
  }
  @media (min-width: 60rem) {
    .daily {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-areas:
        'bench intro'
        'bench play';
      grid-template-rows: auto 1fr;
      gap: var(--space-l) clamp(var(--space-l), 5vw, var(--space-3xl));
      padding-block: var(--space-xl) var(--space-3xl);
    }
    .daily__bench {
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
      align-self: start;
    }
  }

  .daily__no {
    color: var(--ink-muted);
  }
  @media (max-width: 59.99rem) {
    .daily {
      padding-block-start: var(--space-m);
      gap: var(--space-m);
    }
  }
  .daily__intro h1 {
    margin-block: var(--space-2xs) var(--space-s);
  }
  .daily__lede {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-muted);
    max-inline-size: 38ch;
  }
  .daily__noscript {
    margin-block-start: var(--space-s);
  }

  .daily__bench {
    display: grid;
    gap: var(--space-m);
    inline-size: min(100%, 36rem);
    justify-self: center;
  }
  /* Phones held sideways: the protractor sits beside its readings and trace,
     sized to the screen height, so the whole bench fits under the header and
     you can watch the trace while you turn. */
  @media (orientation: landscape) and (max-height: 30rem) and (min-width: 40rem) {
    .daily__bench {
      inline-size: 100%;
      grid-template-columns: min(50%, max(14rem, 100svh - var(--header-h) - 2 * var(--space-s))) minmax(
          0,
          1fr
        );
      grid-template-areas:
        'dial readings'
        'dial trace'
        'dial keys';
      grid-template-rows: auto auto 1fr;
      gap: var(--space-s) var(--space-l);
      align-items: start;
    }
    .daily__bench > :global(.pt) {
      grid-area: dial;
    }
    .daily__readings {
      grid-area: readings;
    }
    .daily__bench :global(.daily__trace) {
      grid-area: trace;
    }
    .daily__keys {
      grid-area: keys;
    }
  }
  .daily__readings {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
  }
  .daily__angle {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }
  .daily__angle-label {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .daily__angle .readout {
    font-size: var(--step-1);
    color: var(--ink-strong);
  }
  .daily__sound {
    color: var(--ink-muted);
  }
  .daily__sound[aria-pressed='true'] {
    color: var(--ink-strong);
    --btn-line: var(--ink);
  }
  .daily__wave {
    opacity: 0;
  }
  .daily__sound[aria-pressed='true'] .daily__wave {
    opacity: 1;
  }
  .daily__keys {
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  /* Touch screens get touch instructions; the key list is for keyboards. */
  .daily__keys--coarse {
    display: none;
  }
  @media (pointer: coarse) {
    .daily__keys--fine {
      display: none;
    }
    .daily__keys--coarse {
      display: block;
    }
  }
  .sound-state {
    min-inline-size: 3ch;
    text-align: start;
    font-size: 0.85em;
  }
  kbd {
    padding: 0.05em 0.4em;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xs);
    color: var(--ink);
  }
  /* The stepper buttons, drawn in the copy the way they look by the dial. */
  .daily__glyph {
    display: inline-grid;
    place-items: center;
    inline-size: 1.6em;
    block-size: 1.6em;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    line-height: 1;
  }

  /* ---- Tries ------------------------------------------------------------------ */
  .daily__tries {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .try {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink-faint);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .try[data-state='next'] {
    border-color: var(--ink-strong);
  }
  .try[data-state='miss'] {
    border-color: var(--ink-strong);
    background: var(--ink-strong);
  }
  .try[data-state='hit'] {
    border-color: var(--ink-strong);
    background: linear-gradient(90deg, var(--ink-strong) 50%, transparent 50%);
  }
  .daily__try-count {
    margin-inline-start: var(--space-xs);
    color: var(--ink-muted);
  }

  /* ---- Answer keys ----------------------------------------------------------- */
  .keys {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }
  @media (min-width: 40rem) {
    .keys {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .key {
      min-block-size: 5.5rem;
      padding-block: var(--space-s);
    }
  }
  .key {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.2rem;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 4.25rem;
    padding: var(--space-xs) var(--space-m) var(--space-xs) var(--space-s);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-m);
    text-align: start;
    background: var(--bg);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }
  @media (hover: hover) {
    .key:hover {
      border-color: var(--ink-strong);
    }
  }
  .key:active {
    transform: translateY(1px);
  }
  .key__name {
    font-size: var(--step-1);
    font-weight: 760;
    font-stretch: var(--stretch-display);
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    line-height: 1.1;
  }
  .key__feel {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.4;
  }
  .key__state {
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    font-size: var(--step--2);
  }
  .key[aria-disabled='true'] {
    cursor: default;
  }
  .key[aria-disabled='true']:active {
    transform: none;
  }
  .key[data-state='wrong'] {
    background: var(--bg-raised);
    border-color: var(--line);
  }
  .key[data-state='wrong'] .key__name {
    color: var(--ink-muted);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .key[data-state='wrong'] .key__state {
    color: var(--ink-muted);
  }
  .key[data-state='right'] {
    background: var(--key-feel);
    border-color: var(--key-feel);
  }
  .key[data-state='right'] :is(.key__name, .key__feel, .key__state) {
    color: var(--graphite-950);
  }
  .key[data-state='reveal'] {
    border: 2px solid var(--ink-strong);
  }
  .key[data-state='reveal'] .key__state {
    color: var(--ink-strong);
  }
  :global(daily-detent[data-state='done']) .key[data-state='open'] {
    opacity: 0.55;
  }
  :global(daily-detent[data-flash='miss']) .keys {
    animation: nudge var(--dur-3) var(--ease-out);
  }
  @keyframes nudge {
    30% {
      translate: -3px 0;
    }
    60% {
      translate: 2px 0;
    }
  }

  .daily__feedback {
    min-block-size: 1.6em;
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink);
  }

  /* ---- Result ----------------------------------------------------------------- */
  .result {
    display: none;
    margin-block: var(--space-l) var(--space-xl);
    padding-block-start: var(--space-l);
    border-block-start: 2px solid var(--ink-strong);
  }
  :global(daily-detent[data-state='done']) .result {
    display: block;
  }
  .result__title {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }
  .result__title::before {
    content: '';
    flex: none;
    inline-size: 0.62em;
    block-size: 0.62em;
    border-radius: 50%;
    background: var(--feel);
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / 0.12);
  }
  .result__title:focus {
    outline: none;
  }
  .result__sub {
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    color: var(--ink);
    max-inline-size: 42ch;
  }
  .result__feel {
    margin-block-start: var(--space-s);
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }
  .result__cut {
    margin-block: var(--space-m);
  }
  .result__cut h3 {
    font-size: var(--step--1);
    font-weight: 620;
    color: var(--ink-muted);
  }
  .result__cut ul {
    margin-block-start: var(--space-3xs);
    padding-inline-start: 1.1em;
    color: var(--ink);
  }
  .result__share {
    margin: 0;
    padding: var(--space-s);
    border-radius: var(--r-m);
    background: var(--surface);
    color: var(--ink-strong);
    font-size: var(--step--1);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .result__actions {
    margin-block-start: var(--space-s);
    --cluster-gap: var(--space-xs);
  }
  .result__status {
    min-block-size: 1.5em;
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .result__feel-link {
    margin-block-start: var(--space-s);
  }
  .result__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-start: var(--space-xl);
    border-block: 1px solid var(--line);
  }
  .result__stats > div {
    padding-block: var(--space-xs);
  }
  .result__stats dt {
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  .result__stats dd {
    font-size: var(--step-2);
    color: var(--ink-strong);
  }
