---
import LegalPage from '@/components/info/LegalPage.astro';
import { SITE } from '@/config/site';
import { STORED_KEYS } from '@/data/legal';

// The table below promises it is the complete list. Hold it to that at build
// time: every key a feature passes to read()/write()/remove() from
// @/lib/storage, as a literal or a same-file constant, must be listed.
const sources = import.meta.glob<string>(['/src/**/*.{ts,astro}', '!/src/lib/storage.ts', '!/src/pages/legal/**'], {
  query: '?raw',
  import: 'default',
  eager: true,
});
const listed = new Set(STORED_KEYS.map((k) => k.key));
for (const [file, src] of Object.entries(sources)) {
  if (!/from\s+['"]@\/lib\/storage['"]/.test(src)) continue;
  for (const [, arg] of src.matchAll(/(?<![.\w])(?:read|write|remove)(?:<.*?>)?\(\s*([^,)\s]+)/g)) {
    const key = /^['"`]/.test(arg!) ? arg!.slice(1, -1) : src.match(new RegExp(`const ${arg}\\s*=\\s*['"\`]([^'"\`]+)['"\`]`))?.[1];
    if (!key) throw new Error(`Privacy page: cannot resolve the storage key "${arg}" in ${file}. Use a literal or a same-file const.`);
    if (!listed.has(`detent:${key}`)) throw new Error(`Privacy page: ${file} stores "detent:${key}", which STORED_KEYS in src/data/legal.ts does not list.`);
  }
}
---

<LegalPage
  title="Privacy"
  heading="Privacy."
  description="Detent's privacy policy in plain words: this concept site collects nothing, sets no cookies, loads no third parties, and keeps what you do in your own browser."
  summary="This site collects nothing about you. No cookies, no analytics service, no third parties, no accounts. Anything you type or choose here stays in your own browser, and you can wipe it below."
  other={{ label: 'Terms', href: '/legal/terms/' }}
  dial={{ text: '0 KB', finish: 'graphite', profile: 'wall' }}
>
  <h2>What we collect</h2>
  <p>
    Nothing. The site is a set of static files. There is no server of ours behind it, no database and no form endpoint. The waitlist, the reservation,
    the cart and the integration requests are demos: they save to your browser’s local storage and are never sent anywhere.
  </p>

  <h2>What stays in your browser</h2>
  <p>These are the only things the site writes, all under keys that start with <code>detent:</code>. Most only appear after you use the feature they belong to.</p>
  <div class="keys" tabindex="0" role="region" aria-label="Storage keys this site uses">
    <!-- Explicit roles: the phone layout restyles rows as grids, which can drop table semantics. -->
    <table role="table">
      <caption class="visually-hidden">Browser storage keys this site uses</caption>
      <thead role="rowgroup">
        <tr role="row"><th scope="col" role="columnheader">Key</th><th scope="col" role="columnheader">Where</th><th scope="col" role="columnheader">What it holds</th></tr>
      </thead>
      <tbody role="rowgroup">
        {
          STORED_KEYS.map((k) => (
            <tr role="row">
              <th scope="row" role="rowheader" class="readout">{k.key}</th>
              <td role="cell" class="keys__area">{k.area}</td>
              <td role="cell">{k.what}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="inspect" aria-labelledby="inspect-h" data-inspect data-js-only>
    <h3 id="inspect-h" class="inspect__title">Right now, this browser holds</h3>
    <ul class="inspect__list" role="list" data-inspect-list></ul>
    <p class="inspect__empty" data-inspect-empty hidden>Nothing. This browser has no Detent data at all.</p>
    <div class="inspect__actions">
      <button type="button" class="btn btn--sm" data-inspect-clear>Clear everything Detent stored</button>
      <p class="inspect__status" role="status" data-inspect-status></p>
    </div>
  </section>

  <h2>Cookies</h2>
  <p>None. The site sets no cookies, and nothing on it sets them on our behalf.</p>

  <h2>Analytics</h2>
  <p>
    When you use the site, small events like “turned the dial” or “opened an answer” are added to a list that lives in the page’s memory, so an
    analytics tool could be connected later. In this build nothing reads that list and nothing is sent. It disappears when you leave the page.
  </p>

  <h2>Third parties</h2>
  <p>
    None. Fonts are served from this site. There are no embeds, trackers or scripts from other domains. Links to other sites, like GitHub, are plain
    links: once you follow one, that site’s own policy applies.
  </p>

  <h2>Hosting</h2>
  <p>
    GitHub Pages serves these files. Like any web host, GitHub receives your IP address and the page you asked for, and may keep logs to run and secure
    the service. That is covered by <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub’s privacy statement</a>, not by anything we control.
  </p>
  <p>
    Some browsers load a page early when you point at a link, so it opens instantly. That early request goes to GitHub Pages like any other, and the
    site records nothing until you actually open the page.
  </p>

  <h2>Questions</h2>
  <p>
    Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Because Detent is a concept, that address is a placeholder and does not receive mail,
    which is also the most private inbox we could offer.
  </p>
</LegalPage>

<script>
  import { STORED_KEYS } from '@/data/legal';

  const root = document.querySelector<HTMLElement>('[data-inspect]');
  const list = root?.querySelector<HTMLElement>('[data-inspect-list]');
  const empty = root?.querySelector<HTMLElement>('[data-inspect-empty]');
  const status = root?.querySelector<HTMLElement>('[data-inspect-status]');
  const known = new Map(STORED_KEYS.map((k) => [k.key, k.what]));

  function areas(): [string, Storage][] {
    const out: [string, Storage][] = [];
    try {
      out.push(['localStorage', localStorage]);
    } catch {
      /* blocked */
    }
    try {
      out.push(['sessionStorage', sessionStorage]);
    } catch {
      /* blocked */
    }
    return out;
  }

  function entries() {
    const rows: { key: string; area: string; bytes: number }[] = [];
    for (const [name, s] of areas()) {
      for (let i = 0; i < s.length; i++) {
        const key = s.key(i);
        if (!key?.startsWith('detent:')) continue;
        rows.push({ key, area: name, bytes: new Blob([s.getItem(key) ?? '']).size });
      }
    }
    return rows.sort((a, b) => a.key.localeCompare(b.key));
  }

  function render() {
    if (!list || !empty) return;
    const rows = entries();
    list.replaceChildren(
      ...rows.map((r) => {
        const li = document.createElement('li');
        const k = document.createElement('span');
        k.className = 'readout inspect__key';
        k.textContent = r.key;
        const meta = document.createElement('span');
        meta.className = 'inspect__meta';
        meta.textContent = `${r.area}, ${r.bytes} bytes. ${known.get(r.key) ?? 'Not in the list above: left by an older version of this site. Safe to clear.'}`;
        li.append(k, meta);
        return li;
      }),
    );
    empty.hidden = rows.length > 0;
  }

  root?.querySelector('[data-inspect-clear]')?.addEventListener('click', () => {
    const n = entries().length;
    for (const [, s] of areas()) {
      const keys: string[] = [];
      for (let i = 0; i < s.length; i++) {
        const key = s.key(i);
        if (key?.startsWith('detent:')) keys.push(key);
      }
      keys.forEach((k) => s.removeItem(k));
    }
    render();
    if (status) status.textContent = n ? `Cleared ${n} item${n === 1 ? '' : 's'}. Reload any open Detent tabs to see them reset.` : 'There was nothing to clear.';
  });

  render();
  addEventListener('storage', render);
</script>

<style>
  :global(html:not([data-js])) [data-js-only] {
    display: none !important;
  }
  /* The table follows the column it sits in, not the viewport: beside the
     sticky heading that column is narrower than a phone's on some laptops. */
  .keys {
    container: keys / inline-size;
    overflow-x: auto;
  }
  table {
    inline-size: 100%;
    min-inline-size: 34rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.65rem 0.75rem 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font-weight: 650;
    color: var(--ink-muted);
    border-bottom-color: var(--line-strong);
  }
  tbody th {
    font-weight: 450;
    color: var(--ink-strong);
    white-space: nowrap;
  }
  td {
    color: var(--ink);
    text-wrap: pretty;
  }
  /* Wide column: the key column is as wide as the longest key, where it lives
     sits under the key, and what it holds gets the rest of the row, about 45
     characters a line instead of 30. Subgrid keeps every row's columns lined
     up; without it the plain table above stays. */
  @supports (grid-template-columns: subgrid) {
    @container keys (width >= 40rem) {
      table {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: var(--space-l);
        min-inline-size: 0;
      }
      thead,
      tbody,
      tr {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
      }
      tr {
        row-gap: 0.15rem;
        padding-block: 0.65rem;
        border-bottom: 1px solid var(--line);
      }
      /* A tall description grows the second row, so where stays under its key. */
      tbody tr {
        grid-template-rows: auto 1fr;
      }
      thead tr {
        position: relative;
        border-bottom-color: var(--line-strong);
      }
      th,
      td {
        padding: 0;
        border: 0;
      }
      tr > :first-child {
        grid-area: 1 / 1;
      }
      tbody tr > :last-child {
        grid-area: 1 / 2 / span 2;
      }
      thead tr > :last-child {
        grid-area: 1 / 2;
      }
      .keys__area {
        grid-area: 2 / 1;
        font-size: var(--step--2);
        color: var(--ink-muted);
      }
      /* "Where" is plain from each entry (localStorage under the key): the
         header keeps it for screen readers only. */
      thead th:nth-child(2) {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }
  }
  /* Narrow column: each key becomes a two-line entry (key and where, then what
     it holds) instead of a 34rem table scrolled mostly out of view. */
  @container keys (width < 40rem) {
    table {
      min-inline-size: 0;
      border-top: 1px solid var(--line-strong);
    }
    thead {
      display: none;
    }
    tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.2rem var(--space-s);
      align-items: baseline;
      padding-block: var(--space-s);
      border-bottom: 1px solid var(--line);
    }
    th,
    td {
      padding: 0;
      border: 0;
    }
    tbody th {
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .keys__area {
      font-size: var(--step--2);
      color: var(--ink-muted);
    }
    td:last-child {
      grid-column: 1 / -1;
      max-inline-size: 66ch;
    }
  }
  .inspect {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--r-m);
    background: var(--bg-raised);
  }
  .inspect__title {
    font-size: var(--step-0);
    font-weight: 700;
    font-stretch: var(--stretch-ui);
  }
  .inspect__list {
    display: grid;
    gap: var(--space-2xs);
  }
  .inspect__list :global(li) {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  .inspect__list :global(.inspect__key) {
    color: var(--ink-strong);
  }
  .inspect__list :global(.inspect__meta) {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .inspect__empty {
    color: var(--ink-muted);
  }
  .inspect__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
  }
  .inspect__status {
    font-size: var(--step--1);
    color: var(--ink-strong);
  }
</style>
