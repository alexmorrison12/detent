---
/**
 * Reserve: "$20, fully refundable." The hero is the whole form: edition,
 * finish (the dial previews it), email, and the Turn-to-reserve ritual:
 * three detents and a virtual end stop arm the button with a tally fill.
 * The plain button always works on the first click; the ritual is a bonus.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import DialStage from '@/components/dial/DialStage.astro';
import DialStill from '@/components/dial/DialStill.astro';
import PhaseCTA from '@/components/PhaseCTA.astro';
import PhaseNotice from '@/components/launch/PhaseNotice.astro';
import EmailField from '@/components/launch/EmailField.astro';
import ConceptNote from '@/components/launch/ConceptNote.astro';
import LaunchTimeline from '@/components/launch/LaunchTimeline.astro';
import LaunchFaq from '@/components/launch/LaunchFaq.astro';
import StickyCta from '@/components/launch/StickyCta.astro';
import { faqLd, productLd } from '@/components/launch/ld';
import { shipsByPhase } from '@/components/launch/ships';
import { PHASES, LAUNCH } from '@/config/launch';
import { ogPath } from '@/config/og';
import { SITE } from '@/config/site';
import { EDITIONS, FINISHES, FAQS, PAYMENT, SPECS, byEdition, formatUsd } from '@/data/product';
import { REFERRAL } from '@/data/shop';
import { url } from '@/lib/url';
import { IS_DEMO } from '@/lib/waitlist';
import { dotDate, longDate, serialRange } from '@/scripts/launch/format';

const one = EDITIONS.find((e) => e.id === 'one')!;
const founders = EDITIONS.find((e) => e.id === 'founders')!;
const deposit = (id: string) => (id === 'founders' ? LAUNCH.foundersDepositUsd : LAUNCH.depositUsd);
// A launch price is one below the regular price: Detent One has one, Founders doesn't.
const foundersFlat = founders.launchPriceUsd >= founders.priceUsd;
const usd = formatUsd;
const serials = serialRange(LAUNCH.foundersRun);
// "Four Torx screws. Battery, foot and knob cap sold as parts" -> the parts sentence.
const repairParts = (SPECS.flatMap((g) => g.rows).find((r) => r.label === 'Repair')?.value ?? '')
  .split('. ')
  .slice(1)
  .join('. ');
const faqs = FAQS.filter((f) => f.topic === 'Launch' || f.q.startsWith('What if I do not love it'));

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const reserveLabel = (id: string) => `Reserve for ${usd(deposit(id))}`;
const reserveDot = dotDate(PHASES.reserve.starts);
const endDot = dotDate(LAUNCH.launchPriceEnds);
// When a reservation ships, per phase (PHASES[p].ships): never a batch number typed here.
const reservationShips = shipsByPhase(['tease', 'waitlist', 'reserve']);
const shippingReadout =
  PAYMENT.freeShippingOverUsd === 0 ? 'Free' : `Over ${usd(PAYMENT.freeShippingOverUsd)}`;
const shippingLine =
  PAYMENT.freeShippingOverUsd === 0
    ? 'Everywhere we ship, tracked and insured.'
    : `Free on orders over ${usd(PAYMENT.freeShippingOverUsd)}, tracked and insured.`;

/**
 * This page takes deposits only while reservations are open. Before that it
 * says when they open; after launch it points at the order. Edition links
 * follow the same phases.
 */
const editionLinks = (id: 'one' | 'founders') => [
  { phases: 'tease', label: PHASES.tease.primary.label, href: url(PHASES.tease.primary.href) },
  {
    phases: 'waitlist',
    label: PHASES.waitlist.primary.label,
    href: url(PHASES.waitlist.primary.href),
  },
  {
    phases: 'launch live',
    label: id === 'one' ? `Order ${byEdition(id).name}` : `Order the ${byEdition(id).name}`,
    href: url(`/shop/?edition=${id}`),
  },
];

// Ritual arc geometry: 0° to 90° (three 30° detents, then the stop).
const polar = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(Math.sin(a) * r).toFixed(2), y: +(-Math.cos(a) * r).toFixed(2) };
};
const arc0 = polar(0, 124);
const arc90 = polar(90, 124);
const detentMarks = [30, 60, 90].map((d, i) => ({
  n: i + 1,
  a: polar(d, 116),
  b: polar(d, 132),
  label: polar(d, 146),
}));
const stopA = polar(96, 110);
const stopB = polar(96, 138);
---

<BaseLayout
  title={`Reserve for ${usd(LAUNCH.depositUsd)}. Fully refundable.`}
  description={`Hold your place for ${SITE.product} with a ${usd(LAUNCH.depositUsd)} deposit that comes off the price. Locks the ${usd(one.launchPriceUsd)} launch price. Reservations ship in ${PHASES.reserve.ships}. Cancel any time before it ships for all of it back.`}
  ogImage={ogPath('reserve')}
  ogImageAlt={`Reserve Detent One for ${usd(LAUNCH.depositUsd)}. Fully refundable.`}
  chrome="minimal"
  jsonLd={[productLd(Astro.site, pageUrl), faqLd(faqs)]}
>
  <!-- impeccable-disable numbered-section-markers -- MM.DD launch dates (10.20, 11.10, 12.01) are real dates, not section markers -->
  <PhaseNotice
    placement="reserve-notice"
    notices={{
      tease: `Reservations open ${dotDate(PHASES.reserve.starts)}. Get the first look now and you’ll hear first.`,
      waitlist: `Reservations open ${longDate(PHASES.reserve.starts)}. Join the list and you get the email that minute.`,
      launch: `Orders are open. Skip the deposit and order at ${usd(one.launchPriceUsd)}.`,
      live: `${SITE.product} is in the store now. Free shipping, ${PAYMENT.trialDays}-day studio trial.`,
    }}
  />

  <section class="rv" aria-labelledby="rv-title" data-rv style="--arm: 0">
    <div class="container rv__grid">
      <div class="rv__head">
        <!-- prettier-ignore -->
        <h1 id="rv-title" class="rv__title"><span data-phase-only="reserve">Reserve for <span class="readout rv__amount" data-amount>{usd(LAUNCH.depositUsd)}</span>.<span class="rv__title-2">Fully refundable.</span></span><span data-phase-only="tease waitlist">Reservations open <span class="readout rv__amount">{reserveDot}</span>.<span class="rv__title-2">{usd(LAUNCH.depositUsd)}, fully refundable.</span></span><span data-phase-only="launch">Orders are open.<span class="rv__title-2">No deposit needed.</span></span><span data-phase-only="live">Reservations are closed.<span class="rv__title-2">{SITE.product} is in the store.</span></span></h1>
        <div class="rv__intro">
          <p class="rv__lede">
            <strong class="rv__what">
              {SITE.product} is a machined aluminum dial whose clicks change with every app.
            </strong>{' '}
            <span data-phase-only="reserve">
              The deposit locks the {usd(one.launchPriceUsd)} launch price and comes off it. Change
              your mind before it ships and every dollar comes back.
            </span>
            <span data-phase-only="tease waitlist">
              From {longDate(PHASES.reserve.starts)}, {usd(LAUNCH.depositUsd)} holds your place in
              line and locks the {usd(one.launchPriceUsd)} launch price. Until then, nothing to pay.
            </span>
            <span data-phase-only="launch">
              Order it outright at the {usd(one.launchPriceUsd)} launch price until {endDot}. After
              that it’s {usd(one.priceUsd)}.
            </span>
            <span data-phase-only="live">
              {usd(one.priceUsd)}, with a {PAYMENT.warrantyYears}-year warranty on parts and labor.
            </span>
          </p>
          <div id="rv-cta" class="rv__cta" data-phase-only="tease waitlist launch live">
            <PhaseCTA
              placement="reserve-hero"
              size="lg"
              phases={['tease', 'waitlist', 'launch', 'live']}
            />
          </div>
        </div>
      </div>

      <form
        id="reserve-form"
        class="rv__form"
        novalidate
        method="dialog"
        aria-labelledby="rv-title"
        data-reserve
      >
        <div class="rv__fields" data-phase-only="reserve">
          <fieldset class="rv__set">
            <legend>Edition</legend>
            <div class="editions">
              {EDITIONS.map((e) => (
                <label class="edition">
                  <input type="radio" name="edition" value={e.id} checked={e.id === 'one'} />
                  <span class="edition__name">{e.name}</span>
                  <span class="edition__price readout">
                    {e.launchPriceUsd < e.priceUsd && (
                      <>
                        <span class="visually-hidden">Regular price</span>
                        <s>{usd(e.priceUsd)}</s>
                        <span class="visually-hidden">, launch price</span>{' '}
                      </>
                    )}
                    {usd(e.launchPriceUsd)}
                  </span>
                  <span class="edition__meta">
                    {usd(deposit(e.id))} deposit
                    {e.limited ? ` · numbered ${serialRange(e.limited)}` : ''}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="rv__set">
            <legend>
              Finish{' '}
              <span class="rv__finish-name" data-finish-name>
                Graphite
              </span>
            </legend>
            <div class="finishes">
              {FINISHES.map((f) => (
                <label class="finish" title={f.line}>
                  <input
                    type="radio"
                    name="finish"
                    value={f.id}
                    checked={f.id === 'graphite'}
                    data-founders={f.foundersOnly ? '' : undefined}
                  />
                  <span class="finish__chip" style={`--swatch:${f.body}`} aria-hidden="true" />
                  <span class="visually-hidden">
                    {f.foundersOnly ? `${f.name}, Founders Edition only` : f.name}
                  </span>
                </label>
              ))}
            </div>
            <p class="rv__finish-line" data-finish-line>
              {FINISHES.find((f) => f.id === 'graphite')!.line}
            </p>
          </fieldset>

          <EmailField id="reserve-email" label="Email for your reservation" />
        </div>

        <div class="rv__stage">
          <div class="ritual" data-ritual>
            <svg
              class="ritual__arc"
              viewBox="-170 -170 340 340"
              aria-hidden="true"
              data-phase-only="reserve"
            >
              <path
                class="ritual__track"
                d={`M ${arc0.x} ${arc0.y} A 124 124 0 0 1 ${arc90.x} ${arc90.y}`}
              ></path>
              <path
                class="ritual__fill"
                d={`M ${arc0.x} ${arc0.y} A 124 124 0 0 1 ${arc90.x} ${arc90.y}`}
                pathLength="1"
              ></path>
              <line
                class="ritual__zero"
                x1={polar(0, 116).x}
                y1={polar(0, 116).y}
                x2={polar(0, 132).x}
                y2={polar(0, 132).y}
              ></line>
              {detentMarks.map((m) => (
                <g class="ritual__mark" data-detent={m.n}>
                  <line x1={m.a.x} y1={m.a.y} x2={m.b.x} y2={m.b.y} />
                  <text
                    x={m.label.x}
                    y={m.label.y}
                    text-anchor="middle"
                    dominant-baseline="central"
                  >
                    {m.n}
                  </text>
                </g>
              ))}
              <line class="ritual__stop" x1={stopA.x} y1={stopA.y} x2={stopB.x} y2={stopB.y}></line>
              <text class="ritual__hint" x="-14" y="-140" text-anchor="end">
                Turn to reserve
              </text>
            </svg>
            <div class="ritual__dial">
              <DialStage
                id="reserve-dial"
                interactive
                finish="graphite"
                profile="ratchet"
                camera="config"
                display="TURN"
                label="Turn to reserve. Optional: the button works without it"
                priority
                sizes="(min-width: 60rem) 21.2rem, (min-width: 40rem) 14.2rem, (min-width: 25rem) 12.4rem, 50vw"
              />
            </div>
          </div>
        </div>

        <div class="rv__submit" data-phase-only="reserve">
          <button
            class="btn btn--primary btn--lg rv__btn"
            type="submit"
            id="reserve-submit"
            data-track="cta_click"
            data-track-placement="reserve-form"
          >
            <span class="rv__btn-fill" aria-hidden="true"></span>
            <span class="rv__btn-label" data-label>
              {reserveLabel('one')}
            </span>
          </button>
          <p class="rv__summary" data-summary aria-live="polite">
            {one.name} · Graphite · {usd(LAUNCH.depositUsd)} today,{' '}
            {usd(one.launchPriceUsd - LAUNCH.depositUsd)} when your batch ships.
          </p>
          <p class="rv__feel" data-feel-line hidden>
            <span class="rv__feel-dot" aria-hidden="true"></span>
            <strong data-feel-name></strong> <span data-feel-text></span>
          </p>
          <p class="rv__ritual-note">
            Three clicks on the dial arm it. Or just press it; it works either way.
          </p>
          <ConceptNote
            subject="your reservation"
            live="No card is charged until you confirm on the next screen."
          />
          <noscript>
            <p class="concept-note">This form needs JavaScript in the concept demo.</p>
          </noscript>
        </div>
      </form>

      <div class="rv__done" data-reserve-done hidden>
        <p class="rv__done-id">
          <span class="rv__done-label">Reservation</span>
          <span class="readout" data-res-id></span>
        </p>
        <h2 class="rv__done-title" tabindex="-1">
          You’re in line.
        </h2>
        <dl class="rv__done-spec">
          <div>
            <dt>Edition</dt>
            <dd data-res-edition></dd>
          </div>
          <div>
            <dt>Finish</dt>
            <dd data-res-finish></dd>
          </div>
          <div data-res-feel-row hidden>
            <dt>First feel</dt>
            <dd data-res-feel></dd>
          </div>
          <div>
            <dt>Deposit</dt>
            <dd class="readout" data-res-deposit></dd>
          </div>
          <div>
            <dt>When it ships</dt>
            <dd>
              <span class="readout" data-res-balance></span>{' '}
              <span class="rv__done-aside" data-res-balance-note></span>
            </dd>
          </div>
          <div>
            <dt>Ships</dt>
            {/* Shown only while reservations are open, so it's the reserve phase's batch. */}
            <dd>{PHASES.reserve.ships}, in reservation order.</dd>
          </div>
        </dl>
        <p class="rv__done-others" data-res-others hidden></p>
        <p class="rv__done-refer">
          Send a friend your link. When theirs ships, you both get a feel you can’t buy: the{' '}
          {REFERRAL.profile}, with {REFERRAL.detail}.
        </p>
        <div class="rv__done-actions">
          <button class="btn btn--primary" type="button" data-ics-launch>
            Add launch day to your calendar
          </button>
          <button class="btn" type="button" data-share-reservation>
            Send a friend the link
          </button>
          <button class="btn btn--quiet" type="button" data-cancel>
            Cancel and refund
          </button>
        </div>
        <p class="rv__done-status" role="status" data-done-status></p>
        <p class="concept-note">
          {IS_DEMO
            ? 'Concept demo: no card was charged and nothing was sent. This reservation exists only in this browser.'
            : 'A receipt is on its way to your inbox.'}
        </p>
      </div>
    </div>
  </section>

  <section
    class="how"
    data-world="day"
    aria-labelledby="how-title"
    data-phase-only="tease waitlist reserve"
  >
    <div class="container">
      <h2 id="how-title" class="rv-h2">
        How the {usd(LAUNCH.depositUsd)} works
      </h2>
      <ol class="how__steps" role="list">
        <li class="how__step">
          <span class="how__n readout" aria-hidden="true">
            1
          </span>
          <h3>Reserve</h3>
          <p>
            Pay {usd(LAUNCH.depositUsd)} ({usd(LAUNCH.foundersDepositUsd)} for Founders). It holds
            your place in line and locks the {usd(one.launchPriceUsd)} launch price on {one.name}.{' '}
            {foundersFlat
              ? `Founders is always ${usd(founders.priceUsd)}.`
              : `Founders locks ${usd(founders.launchPriceUsd)}.`}
          </p>
        </li>
        <li class="how__step">
          <span class="how__n readout" aria-hidden="true">
            2
          </span>
          <h3>We email when your batch is ready</h3>
          <p>
            {reservationShips.map((g) => (
              <span data-phase-only={g.phases}>
                Reservations ship in {g.ships}, in the order they came in.
              </span>
            ))}{' '}
            You get a ship date before we ask for anything else.
          </p>
        </li>
        <li class="how__step how__step--stop">
          <span class="how__n readout" aria-hidden="true">
            3
          </span>
          <h3>Complete or cancel</h3>
          <p>
            Pay the rest ({usd(one.launchPriceUsd - LAUNCH.depositUsd)} on {one.name}) and it ships
            free. Or cancel for a full refund. One click, no questions, no call.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="eds" data-world="day" aria-labelledby="eds-title">
    <div class="container">
      <h2 id="eds-title" class="rv-h2">
        Two editions. No decoy.
      </h2>
      <div class="eds__grid">
        <article class="ed" aria-labelledby="ed-one">
          <div class="ed__stills" aria-hidden="true">
            {one.finishes.map((f) => (
              <div class="ed__still">
                <DialStill finish={f} view="hero" sizes="(min-width: 60rem) 15rem, 30vw" />
              </div>
            ))}
          </div>
          <h3 id="ed-one" class="ed__name">
            {one.name}
          </h3>
          <p class="ed__price" data-phase-only="tease waitlist reserve launch">
            <span class="readout ed__now">{usd(one.launchPriceUsd)}</span>
            <span class="ed__was">
              {usd(one.priceUsd)} from {endDot}
            </span>
          </p>
          <p class="ed__price" data-phase-only="live">
            <span class="readout ed__now">{usd(one.priceUsd)}</span>
          </p>
          <p class="ed__summary">{one.summary}</p>
          <ul class="ed__list" role="list">
            {one.includes.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
          <a
            class="link-arrow ed__link"
            href="#reserve-form"
            data-pick-edition="one"
            data-phase-only="reserve"
          >
            Pick this edition
          </a>
          {editionLinks('one').map((c) => (
            <a
              class="link-arrow ed__link"
              href={c.href}
              data-phase-only={c.phases}
              data-track="cta_click"
              data-track-placement="reserve-edition-one"
            >
              {c.label}
            </a>
          ))}
        </article>

        <article class="ed ed--founders" aria-labelledby="ed-founders">
          <div class="ed__stills" aria-hidden="true">
            <div class="ed__still ed__still--solo">
              <DialStill finish="tally" view="hero" sizes="(min-width: 60rem) 17rem, 40vw" />
            </div>
          </div>
          <h3 id="ed-founders" class="ed__name">
            {founders.name}
          </h3>
          <p class="ed__price">
            <span class="readout ed__now">{usd(founders.launchPriceUsd)}</span>
            <span class="ed__was">numbered {serials}</span>
          </p>
          <p class="ed__summary">
            A numbered run of {LAUNCH.foundersRun.toLocaleString('en-US')} in Tally red. When they
            are reserved, Tally is gone. We don’t show a stock counter because we won’t fake one.
          </p>
          <ul class="ed__list" role="list">
            {founders.includes.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
          <a
            class="link-arrow ed__link"
            href="#reserve-form"
            data-pick-edition="founders"
            data-phase-only="reserve"
          >
            Pick this edition
          </a>
          {editionLinks('founders').map((c) => (
            <a
              class="link-arrow ed__link"
              href={c.href}
              data-phase-only={c.phases}
              data-track="cta_click"
              data-track-placement="reserve-edition-founders"
            >
              {c.label}
            </a>
          ))}
        </article>
      </div>
    </div>
  </section>

  <section class="dates" data-world="day" aria-labelledby="dates-title">
    <div class="container">
      <h2 id="dates-title" class="rv-h2">
        The calendar
      </h2>
      <LaunchTimeline labelledBy="dates-title" />
    </div>
  </section>

  <section class="rv-faq" data-world="day" aria-labelledby="faq-title">
    <div class="container rv-faq__grid">
      <h2 id="faq-title" class="rv-h2">
        Questions before you put down {usd(LAUNCH.depositUsd)}
      </h2>
      <LaunchFaq faqs={faqs} name="reserve-faq" openFirst />
    </div>
  </section>

  <section class="risk" aria-labelledby="risk-title">
    <div class="container risk__grid">
      <h2 id="risk-title" class="rv-h2">
        If it isn’t for you
      </h2>
      <dl class="risk__list">
        <div class="risk__row" data-phase-only="tease waitlist reserve">
          <dt>Before it ships</dt>
          <dd>
            <span class="readout">{usd(LAUNCH.depositUsd)} back</span> Cancel any time before your
            Detent ships. The whole deposit, one click.
          </dd>
        </div>
        <div class="risk__row">
          <dt>After it arrives</dt>
          <dd>
            <span class="readout">{PAYMENT.trialDays} days</span> Use it in real sessions. If it
            hasn’t earned its spot on your desk, send it back with the prepaid label.
          </dd>
        </div>
        <div class="risk__row">
          <dt>For years</dt>
          <dd>
            <span class="readout">{PAYMENT.warrantyYears} years</span> Warranty on parts and labor.
          </dd>
        </div>
        <div class="risk__row">
          <dt>When it breaks anyway</dt>
          <dd>
            <span class="readout">4 screws</span> Open it with a Torx driver. {repairParts}.
          </dd>
        </div>
        <div class="risk__row">
          <dt>Shipping</dt>
          <dd>
            <span class="readout">{shippingReadout}</span>
            {shippingLine}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="rv-closer" aria-labelledby="rv-closer-title">
    <div class="container rv-closer__inner">
      <h2 id="rv-closer-title" class="rv-closer__title">
        <span data-phase-only="reserve">
          {usd(LAUNCH.depositUsd)} now. The rest when it ships. All of it back if you change your
          mind.
        </span>
        <span data-phase-only="tease waitlist">
          {usd(LAUNCH.depositUsd)} on {reserveDot}. The rest when it ships. All of it back if you
          change your mind.
        </span>
        <span data-phase-only="launch">
          {usd(one.launchPriceUsd)} until {endDot}. Free shipping, and {PAYMENT.trialDays} days to
          decide.
        </span>
        <span data-phase-only="live">
          {usd(one.priceUsd)}. Free shipping, and {PAYMENT.trialDays} days to decide.
        </span>
      </h2>
      <PhaseCTA placement="reserve-closer" size="lg" />
    </div>
  </section>

  <StickyCta
    watch="#reserve-submit, #rv-cta"
    hideOver=".rv__fields, .rv__submit, .rv__done, .rv-closer, .site-footer"
    label={reserveLabel('one')}
    target="#reserve-email"
    note="Fully refundable"
    only="reserve"
  >
    <PhaseCTA
      placement="sticky"
      size="sm"
      showNote={false}
      phases={['tease', 'waitlist', 'launch', 'live']}
    />
  </StickyCta>
</BaseLayout>

<script>
  import '@/scripts/launch/reserve';
</script>

<style>
