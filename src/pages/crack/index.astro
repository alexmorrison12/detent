---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhaseCTA from '@/components/PhaseCTA.astro';
import SafeDial from '@/components/games/SafeDial.astro';
import Trace from '@/components/games/Trace.astro';
import { GAMES } from '@/data/games';
import { byEdition } from '@/data/product';
import { SITE } from '@/config/site';
import { ogPath } from '@/config/og';
import { url, absoluteUrl } from '@/lib/url';
import { dayFromIso, puzzleNumber, utcDay } from '@/scripts/games/day';

const epochDay = dayFromIso(GAMES.epoch);
const buildNumber = puzzleNumber(utcDay(), epochDay);
const engraving = byEdition('one').includes.find((i) => /engraving/i.test(i));

const title = 'Crack the Safe';
const description =
  'A daily safecracking game you play by feel. Turn right, left, right on a 100-number dial and listen for the heavier detent. One new combination for everyone at 00:00 UTC.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Game',
    name: 'Crack the Safe',
    description,
    url: absoluteUrl('/crack/', Astro.site),
    isAccessibleForFree: true,
    inLanguage: SITE.lang,
    numberOfPlayers: { '@type': 'QuantitativeValue', value: 1 },
    publisher: { '@type': 'Organization', name: SITE.legalName, url: absoluteUrl('/', Astro.site) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.product, item: absoluteUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: title, item: absoluteUrl('/crack/', Astro.site) },
    ],
  },
];

const steps = [
  {
    dir: 'Right',
    title: 'Right to the first',
    body: 'Turn clockwise. Wheel one only listens on a right turn, so slow down when a click feels heavier.',
  },
  {
    dir: 'Left',
    title: 'Left to the second',
    body: 'Reverse. Wheel two ignores everything you do going right. Counterclockwise only.',
  },
  {
    dir: 'Right',
    title: 'Right to the third',
    body: 'Clockwise again. Set the last number and the bolt draws back.',
  },
];

// The route, drawn: three turns on one dial, stepping inward. Degrees are
// clockwise from noon; each turn ends on a set point (a tally pin, like the
// pins the game drops on the bezel).
const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [+(r * Math.sin(a)).toFixed(2), +(-r * Math.cos(a)).toFixed(2)] as const;
};
const turns = [
  { from: -24, to: 128, r: 94 },
  { from: 128, to: -118, r: 72 },
  { from: -118, to: 34, r: 50 },
].map((t, i, all) => {
  const cw = t.to > t.from;
  const [x0, y0] = at(t.from, t.r);
  const [x1, y1] = at(t.to, t.r);
  const large = Math.abs(t.to - t.from) > 180 ? 1 : 0;
  // Arc, then a short radial step in to where the next turn starts.
  const next = all[i + 1];
  const step = next ? ` L${at(t.to, next.r).join(' ')}` : '';
  const arc = `M${x0} ${y0} A${t.r} ${t.r} 0 ${large} ${cw ? 1 : 0} ${x1} ${y1}${step}`;
  // Arrowhead a few degrees before the set point, pointing along the turn.
  const tipDeg = t.to - (cw ? 12 : -12);
  const [hx, hy] = at(tipDeg, t.r);
  const a = (tipDeg * Math.PI) / 180;
  const d = cw ? 1 : -1;
  const [tx, ty] = [Math.cos(a) * d, Math.sin(a) * d];
  const [nx, ny] = [Math.sin(a), -Math.cos(a)];
  const pt = (x: number, y: number) => `${x.toFixed(1)} ${y.toFixed(1)}`;
  const head = `M${pt(hx + tx * 9, hy + ty * 9)} L${pt(hx + nx * 6 - tx * 3, hy + ny * 6 - ty * 3)} L${pt(hx - nx * 6 - tx * 3, hy - ny * 6 - ty * 3)} Z`;
  // Step number sits on the middle of its turn, knocking out the line.
  const [lx, ly] = at((t.from + t.to) / 2, t.r);
  return { arc, head, pin: [x1, y1] as const, label: { x: lx, y: ly }, n: i + 1 };
});
const scale = Array.from({ length: 50 }, (_, k) => ({ rot: k * 7.2, long: k % 5 === 0 }));
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogPath('crack')}
  ogImageAlt="Crack the safe: a daily challenge by feel"
  jsonLd={jsonLd}
>
  <safe-game data-epoch-day={epochDay} data-base-strength={GAMES.safe.baseStrength}>
    <section class="crack container" aria-labelledby="crack-title">
      <header class="crack__intro">
        <p class="crack__no readout">
          Safe <span data-safe-no>#{buildNumber}</span> · new at 00:00 UTC
        </p>
        <h1 id="crack-title" class="display display--l">
          Crack the safe.
        </h1>
        <p class="crack__lede">
          Three numbers. A hundred detents. The right one clicks a little heavier.
        </p>
        <noscript>
          <p class="crack__noscript">
            The safe needs JavaScript to turn. The rules below read fine without it.
          </p>
        </noscript>
      </header>

      <p class="crack__dir">
        <span data-dir-lead>Turn </span>
        <strong class="crack__dir-word" data-dir-word>
          right
        </strong>
        <span data-dir-rest> to the first number.</span>
      </p>

      <div class="crack__stage">
        <SafeDial />
      </div>

      <div class="crack__controls">
        <button class="btn btn--solid btn--lg crack__set" type="button" data-set>
          Set{' '}
          <span class="readout crack__set-n" data-set-n>
            00
          </span>
        </button>
        <button class="btn crack__sound" type="button" data-sound aria-pressed="false">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
            <path
              class="crack__wave"
              d="M15.2 9.2a4 4 0 0 1 0 5.6M17.8 6.6a7.6 7.6 0 0 1 0 10.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
          Sound{' '}
          <span class="readout sound-state" aria-hidden="true" data-sound-state>
            off
          </span>
        </button>
        <p class="crack__feedback" role="status" data-feedback></p>
      </div>

      <Trace
        class="crack__trace"
        label="Stethoscope"
        caption="Taller is heavier. Only the wheel you’re on is listening."
      />

      <ol class="crack__wheels" role="list" aria-label="Wheels">
        {['Right', 'Left', 'Right'].map((d, i) => (
          <li class="wheel" data-wheel={i} data-status={i === 0 ? 'active' : 'waiting'}>
            <span class="wheel__label">
              Wheel {i + 1} <span class="wheel__dir">· {d}</span>
            </span>
            <span class="wheel__value readout" data-wheel-value>
              --
            </span>
            <span class="wheel__note" data-wheel-misses />
          </li>
        ))}
      </ol>

      <div class="crack__meters">
        <dl>
          <div>
            <dt>Time</dt>
            <dd class="readout"><span data-time role="timer">
              0:00
            </span></dd>
          </div>
          <div>
            <dt>Sets</dt>
            <dd class="readout" data-sets>
              0
            </dd>
          </div>
        </dl>
        <p class="crack__keys crack__keys--fine">
          Keyboard: focus the dial. <kbd>←</kbd> <kbd>→</kbd> turn one number, <kbd>Page Up</kbd>{' '}
          <kbd>Page Down</kbd> turn four,
          <kbd>Enter</kbd> sets.
        </p>
        <p class="crack__keys crack__keys--coarse">
          Drag the numbered ring or the knob in a circle. To set a number, tap Set or the knob.
        </p>
      </div>

      <div class="crack__done" data-done>
        <h2 class="display display--xl crack__open" tabindex="-1" data-done-heading>
          Open.
        </h2>
        <dl class="crack__result">
          <div>
            <dt>Time</dt>
            <dd class="readout" data-done-time>
              0:00
            </dd>
          </div>
          <div>
            <dt>Sets</dt>
            <dd class="readout" data-done-sets>
              3
            </dd>
          </div>
          <div>
            <dt>First-set wheels</dt>
            <dd class="readout" data-done-clean>
              3/3
            </dd>
          </div>
        </dl>

        <div class="crack__share" data-daily-only>
          <pre class="crack__share-text readout" data-share-text></pre>
          <div class="cluster crack__share-actions">
            <button class="btn btn--primary" type="button" data-copy>
              Copy result
            </button>
            <button class="btn" type="button" data-share hidden>
              Share
            </button>
            <a class="btn" data-save-card hidden href="#">
              Save card
            </a>
          </div>
          <p class="crack__status" role="status" data-share-status></p>
          <p class="crack__next" data-countdown-line>
            Next safe in{' '}
            <time class="readout" data-countdown role="timer">
              --:--:--
            </time>
          </p>
          <p class="crack__next" data-rollover hidden>
            Midnight UTC came and went. A new safe is waiting.{' '}
            <button class="link-arrow crack__reload" type="button" data-reload>
              Load it
            </button>
          </p>
        </div>

        <div class="crack__practice-done" data-practice-only hidden>
          <p>Practice safe, off the record. Today’s safe and your streak are untouched.</p>
          <button class="link-arrow crack__reload" type="button" data-today>
            Back to today’s safe
          </button>
        </div>

        <button class="btn crack__practice" type="button" data-practice>
          Practice on a random safe
        </button>
      </div>
    </section>

    <section class="reward container" data-daily-only aria-labelledby="reward-title">
      <figure class="reward__card" data-card-wrap hidden>
        <div class="reward__img" data-card-slot></div>
        <figcaption>Your share card. Spoiler-free: no numbers on it.</figcaption>
      </figure>
      <div class="reward__text">
        <h2 id="reward-title" class="display display--s">
          The Safecracker engraving.
        </h2>
        <p>
          Every Detent One comes with{' '}
          {engraving ? engraving.toLowerCase() : 'engraving on the base'}. Safecrackers get one more
          option: the safe number and its combination, set around a tiny engraved dial, the way a
          watchmaker signs a movement. The configurator opens with yours already typed in.
        </p>
        <p class="reward__code">
          Your code <span class="readout" data-code></span>
        </p>
        <a
          class="btn btn--solid reward__engrave"
          href={url('/shop/#configure')}
          data-engrave-link
          data-track="crack_engrave"
        >
          Engrave it on a Detent One
        </a>
        <p class="concept-note">
          Detent is a concept product, so there is nothing to redeem this against. The code is a
          keepsake, not a coupon.
        </p>
      </div>
    </section>

    <section class="how container" aria-labelledby="how-title">
      <h2 id="how-title" class="display display--m">
        How to crack it.
      </h2>
      <div class="how__route">
        <svg class="how__dial" viewBox="-124 -124 248 248" aria-hidden="true">
          <circle r="120" class="how__rim"></circle>
          {scale.map((t) => (
            <line
              class:list={['how__tick', t.long && 'how__tick--long']}
              x1="0"
              y1="-120"
              x2="0"
              y2={t.long ? -110 : -114}
              transform={`rotate(${t.rot})`}
            />
          ))}
          <path class="how__index" d="M0 -106 L-6 -122 L6 -122 Z"></path>
          <circle r="30" class="how__knob"></circle>
          {turns.map((t) => (
            <g class="how__turn">
              <path class="how__arc" d={t.arc}></path>
              <path class="how__head" d={t.head}></path>
              <circle class="how__pin" r="5" cx={t.pin[0]} cy={t.pin[1]}></circle>
              <circle class="how__label" r="9" cx={t.label.x} cy={t.label.y}></circle>
              <text
                class="how__n"
                x={t.label.x}
                y={t.label.y}
                text-anchor="middle"
                dominant-baseline="central"
              >
                {t.n}
              </text>
            </g>
          ))}
        </svg>
        <ol class="how__steps" role="list">
          {steps.map((s, i) => (
            <li class="how__step">
              <p class="how__mark readout" aria-hidden="true">
                <span class="how__num">{i + 1}</span> {s.dir}
              </p>
              <h3>{s.title}</h3>
              <p class="how__body">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="how__why">
        <h3 class="display display--s">What you’re feeling.</h3>
        <div class="how__why-body">
          <p>
            Each number is a detent, 3.6° apart. Near the right number the firmware adds torque a
            few percent at a time. One number on every wheel is a false gate: it gets firm, never
            heavy. On a Detent One that is a heavier click under your fingertip. Here it is a lower
            click in your ears and a taller line on the stethoscope.
          </p>
          <p>
            That is software-defined haptics in one sentence: the click isn’t cut into the metal, so
            it can change per number, per app, per millisecond.
          </p>
          <a class="link-arrow" href={url('/profiles/')}>
            Turn the six feels
          </a>
        </div>
      </div>
    </section>

    <section class="record container" aria-labelledby="record-title">
      <div class="record__head">
        <h2 id="record-title" class="display display--s">
          Your record.
        </h2>
        <button class="btn btn--sm" type="button" data-studio-log-open>
          Studio log
        </button>
      </div>
      <p class="record__empty" data-record-empty>
        Nothing on record yet. Open today’s safe and your streak starts at one.
      </p>
      <dl class="record__grid" data-record-grid hidden>
        <div>
          <dt>Streak</dt>
          <dd class="readout record__value" data-stat="streak">
            0
          </dd>
          <dd class="record__note" data-stat="freeze">
            One free freeze a week
          </dd>
        </div>
        <div>
          <dt>Best time</dt>
          <dd class="readout record__value" data-stat="best">
            –
          </dd>
        </div>
        <div>
          <dt>Safes opened</dt>
          <dd class="readout record__value" data-stat="cracked">
            0
          </dd>
        </div>
        <div>
          <dt>All three on the first set</dt>
          <dd class="readout record__value" data-stat="clean">
            0
          </dd>
        </div>
      </dl>
      <p class="concept-note">
        Kept in this browser, never sent anywhere. Miss a day and one free freeze a week carries
        your streak.
      </p>
    </section>

    <section class="also container" aria-labelledby="also-title">
      <div class="also__daily">
        <h2 id="also-title" class="display display--s">
          Also today: name that feel.
        </h2>
        <p>The Daily Detent hides one of six feels on the dial. You get five tries.</p>
        <a class="link-arrow" href={url('/daily/')}>
          Play the Daily Detent
        </a>
      </div>
      <div class="also__cta">
        <p>A hundred detents is one profile. Detent One stores sixty-four.</p>
        <PhaseCTA placement="crack" />
      </div>
    </section>
  </safe-game>
</BaseLayout>

<script>
  import '@/scripts/games/safe-game';
  import { captureRef } from '@/lib/waitlist';
  // Shared results link here with ?ref=; keep it so a later join credits the sharer.
  captureRef();
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest('[data-reload]')) location.reload();
  });
</script>

<style>
  safe-game {
    display: block;
    --w: 0;
  }

  /* ---- The game grid ------------------------------------------------------- */
  .crack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'dir' 'stage' 'controls' 'trace' 'wheels' 'meters' 'done';
    padding-block: var(--space-m) var(--space-2xl);
  }
  .crack__intro {
    grid-area: intro;
  }
  .crack__dir {
    grid-area: dir;
  }
  .crack__stage {
    grid-area: stage;
  }
  .crack__controls {
    grid-area: controls;
  }
  .crack :global(.crack__trace) {
    grid-area: trace;
  }
  .crack__wheels {
    grid-area: wheels;
  }
  .crack__meters {
    grid-area: meters;
  }
  .crack__done {
    grid-area: done;
  }

  /* Two columns on desktop, and on phones held sideways: there the dial can't
     sit above the controls (it would be taller than the screen), so it pins
     beside them like on desktop and you turn and set without scrolling. */
  @media (min-width: 60rem), (orientation: landscape) and (max-height: 30rem) and (min-width: 40rem) {
    .crack {
      grid-template-columns: minmax(0, 1.08fr) minmax(21rem, 0.92fr);
      grid-template-areas:
        'stage intro'
        'stage dir'
        'stage controls'
        'stage trace'
        'stage wheels'
        'stage meters'
        'stage done'
        'stage .';
      grid-template-rows: repeat(7, auto) 1fr;
      column-gap: clamp(var(--space-l), 5vw, var(--space-3xl));
      padding-block: var(--space-xl) var(--space-3xl);
      align-items: start;
    }
    .crack__stage {
      grid-row: 1 / -1;
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
    }
  }

  .crack__no {
    color: var(--ink-muted);
  }
  .crack__intro h1 {
    margin-block: var(--space-2xs) var(--space-s);
  }
  .crack__lede {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-muted);
    max-inline-size: 30ch;
  }
  .crack__noscript {
    margin-block-start: var(--space-s);
    color: var(--ink);
  }

  .crack__dir {
    margin-block-start: var(--space-m);
    font-size: var(--step-2);
    font-weight: 520;
    font-stretch: var(--stretch-ui);
    line-height: 1.15;
    color: var(--ink);
    text-wrap: balance;
  }
  .crack__dir-word {
    display: inline-block;
    color: var(--ink-strong);
    font-weight: calc(660 + var(--w) * 220);
    font-stretch: calc(108% + var(--w) * 17%);
    transition:
      font-weight var(--dur-1) var(--ease-out),
      font-stretch var(--dur-1) var(--ease-out);
  }

  .crack__stage {
    margin-block-start: var(--space-m);
    /* Never taller than the screen under the sticky header, so the index mark
       at noon and the numbers under it are always in view while you turn. */
    inline-size: min(100%, 40rem, max(15rem, 100svh - var(--header-h) - 2 * var(--space-m)));
    justify-self: center;
  }
  @media (min-width: 60rem) {
    .crack__stage {
      margin-block-start: 0;
      justify-self: stretch;
    }
  }
  @media (orientation: landscape) and (max-height: 30rem) and (min-width: 40rem) {
    .crack {
      padding-block-start: var(--space-s);
    }
    .crack__stage {
      top: calc(var(--header-h) + var(--space-s));
      inline-size: min(100%, max(15rem, 100svh - var(--header-h) - 2 * var(--space-s)));
      margin-block-start: 0;
    }
    .crack__controls {
      margin-block-start: var(--space-s);
    }
  }

  .crack__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }
  @media (min-width: 60rem) {
    .crack__controls {
      margin-block-start: var(--space-l);
    }
  }
  .crack__set {
    min-inline-size: 9.5rem;
  }
  .crack__set-n {
    font-size: 0.95em;
    font-weight: 500;
  }
  .crack__sound {
    color: var(--ink-muted);
  }
  .crack__sound[aria-pressed='true'] {
    color: var(--ink-strong);
    --btn-line: var(--ink);
  }
  .crack__wave {
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .crack__sound[aria-pressed='true'] .crack__wave {
    opacity: 1;
  }
  .crack__feedback {
    flex-basis: 100%;
    min-block-size: 1.6em;
    font-size: var(--step--1);
    color: var(--ink);
  }
  :global(safe-game[data-flash='caught']) .crack__feedback {
    color: var(--accent-text);
  }

  .crack :global(.crack__trace) {
    margin-block-start: var(--space-l);
  }

  .crack__wheels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xs);
    margin-block-start: var(--space-l);
  }
  .wheel {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .wheel[data-status='active'] {
    border-color: var(--ink-muted);
  }
  .wheel__label {
    font-size: var(--step--1);
    font-weight: 600;
    font-stretch: var(--stretch-ui);
    color: var(--ink);
  }
  .wheel__dir {
    color: var(--ink-muted);
    font-weight: 500;
  }
  .wheel__value {
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--ink-faint);
  }
  .wheel[data-status='found'] .wheel__value {
    color: var(--ink-strong);
  }
  .wheel[data-status='found'] .wheel__label::after {
    content: '';
    display: inline-block;
    inline-size: 0.5em;
    block-size: 0.5em;
    margin-inline-start: 0.4em;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.08em;
  }
  .wheel__note {
    min-block-size: 1.3em;
    font-size: var(--step--2);
    color: var(--ink-muted);
  }

  .crack__meters {
    margin-block-start: var(--space-l);
  }
  .crack__meters dl,
  .crack__result {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-xl);
  }
  .crack__meters dt,
  .crack__result dt {
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  .crack__meters dd {
    font-size: var(--step-1);
    color: var(--ink-strong);
  }
  .crack__keys {
    margin-block-start: var(--space-s);
    font-size: var(--step--2);
    color: var(--ink-muted);
    line-height: 1.9;
  }
