---
/**
 * Proof: early tester notes, labelled plainly as illustrative personas (the
 * product is a concept). Set as a conversation down the page, each note
 * signed with the feel it is about, drawn as that feel's torque curve.
 */
import { TESTER_NOTES, byProfile } from '@/data/product';
import TorqueGlyph from './TorqueGlyph.astro';
---

<section class="proof section" data-world="day" aria-labelledby="proof-title" id="notes">
  <div class="container">
    <div class="proof__head">
      <h2 id="proof-title" class="display proof__title">
        What testers noticed first.
      </h2>
      <p class="proof__label">
        Early tester notes from illustrative personas. Detent is a concept product, so these are not
        customer reviews.
      </p>
    </div>
    <ul class="notes" role="list">
      {TESTER_NOTES.map((n) => (
        <li class="note" style={`--c: var(--feel-${n.profile})`}>
          <figure class="note__fig">
            <blockquote class="note__quote">
              <p>{n.quote}</p>
            </blockquote>
            <figcaption class="note__who">
              <span class="note__name">{n.name}</span>
              <span class="note__role">{n.role}</span>
              <span class="note__feel">
                <TorqueGlyph profile={n.profile} tone="day" class="note__glyph" />
                on {byProfile(n.profile).name}
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proof {
    background: var(--bg-raised);
  }
  .proof__head {
    display: grid;
    gap: var(--space-s);
    margin-block-end: var(--space-2xl);
  }
  .proof__title {
    font-size: var(--step-4);
    max-inline-size: 14ch;
  }
  .proof__label {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-inline-size: 48ch;
  }
  .notes {
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xl);
  }
  .note__fig {
    margin: 0;
    display: grid;
    gap: var(--space-s);
  }
  .note__quote {
    margin: 0;
  }
  .note__quote p {
    font-size: var(--step-2);
    font-weight: 520;
    font-stretch: 92%;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    text-wrap: pretty;
  }
  .note__quote p::before {
    content: '“';
  }
  .note__quote p::after {
    content: '”';
  }
  .note__who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem var(--space-s);
    font-size: var(--step--1);
  }
  .note__name {
    font-weight: 700;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
  }
  .note__role {
    color: var(--ink-muted);
  }
  .note__feel {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-muted);
  }
  .note__feel :global(.note__glyph) {
    inline-size: 3rem;
    block-size: 1rem;
  }

  @media (min-width: 48rem) {
    .notes {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-l);
      row-gap: var(--space-xl);
    }
    .note {
      grid-column: 1 / span 8;
    }
    .note:nth-child(even) {
      grid-column: 5 / span 8;
    }
  }
  @media (min-width: 64rem) {
    .proof__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
    .note {
      grid-column: 1 / span 7;
    }
    .note:nth-child(even) {
      grid-column: 6 / span 7;
    }
  }
</style>
