---
/**
 * The designed switch from night to day. A tally dot (the on-air light) sits
 * in the dark; as you scroll, the white world opens out of it like an iris,
 * and the iris opens onto the object: Detent One in Raw, on a white desk.
 *
 * The line uses difference blending, so it reads light-on-dark, then
 * dark-on-light, with no JS; the still sits below it so the blend never
 * lands on the metal. The still is clipped by its own circle, keyed to the
 * same timeline and centered on the same point as the iris, so the two open
 * as one. Without scroll timelines, or with reduced motion, it is a calm white
 * band with the still under the line: the finished state.
 */
import DialStill from '@/components/dial/DialStill.astro';
---

<div class="aperture">
  <div class="aperture__pin">
    <span class="aperture__dot" aria-hidden="true"></span>
    <span class="aperture__iris" aria-hidden="true"></span>
    <p class="aperture__line display">
      <span>Now look at it</span>
      <span>in daylight.</span>
    </p>
    <div class="aperture__still">
      <DialStill
        finish="raw"
        view="hero"
        sizes="(min-width: 64rem) 36rem, 78vw"
        alt="Detent One in Raw, bare bead-blasted aluminum, on a white desk. The display reads Ratchet, 00 of 24."
      />
    </div>
  </div>
</div>

<style>
  .aperture {
    position: relative;
    background: var(--graphite-950);
    view-timeline: --aperture block;
  }
  .aperture__pin {
    /* The line is two lines at line-height 1, so its height is known and the
       still's clip circle can be centered on the pin, not on itself. (A
       reader's own text spacing can wrap it to more: then the reveal opens a
       little off-centre and nothing is cut, WCAG 1.4.12.) */
    --ap-fs: min(var(--step-5), 10.5vw);
    --ap-gap: var(--space-l);
    --ap-line: calc(2 * var(--ap-fs));
    --ap-still: min(36rem, 78vw, 62svh);
    /* Iris center (the group's center), in the still's own box. */
    --ap-cy: calc(50% - (var(--ap-line) + var(--ap-gap)) / 2);
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    justify-items: center;
    align-content: center;
    row-gap: var(--ap-gap);
    padding: var(--space-3xl) var(--gutter);
  }
  .aperture__dot,
  .aperture__iris {
    position: absolute;
    pointer-events: none;
  }
  .aperture__dot {
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--tally);
  }
  .aperture__iris {
    inset: 0;
    background: var(--white);
    clip-path: circle(71vmax at 50% 50%);
  }
  .aperture__line {
    position: relative;
    z-index: 1;
    font-size: var(--ap-fs);
    line-height: 1;
    text-align: center;
    color: var(--white);
    mix-blend-mode: difference;
  }
  .aperture__line span {
    display: block;
    text-wrap: balance;
  }
  .aperture__still {
    position: relative;
    inline-size: var(--ap-still);
    aspect-ratio: 1;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .aperture {
        block-size: 150svh;
      }
      /* Pinned under the site header: the group centers in the space below
         it, and the dot and iris center on the group. */
      .aperture__pin {
        --ap-still: min(
          36rem,
          78vw,
          calc(100svh - var(--header-h) - var(--ap-line) - var(--ap-gap) - var(--space-2xl))
        );
        position: sticky;
        inset-block-start: 0;
        block-size: 100svh;
        padding-block: var(--header-h) 0;
      }
      .aperture__dot {
        inset-block-start: calc(50% + var(--header-h) / 2);
      }
      /* Both circles grow from the dot to 71vmax, which covers any corner, on
         one timeline and range, so they stay the same circle throughout. */
      .aperture__iris {
        animation: aperture-open linear both;
        animation-timeline: --aperture;
        animation-range: contain 0% contain 80%;
      }
      .aperture__still {
        animation: aperture-reveal linear both;
        animation-timeline: --aperture;
        animation-range: contain 0% contain 80%;
      }
      .aperture__dot {
        animation: aperture-dot linear both;
        animation-timeline: --aperture;
        animation-range: entry 40% contain 5%;
      }
      @keyframes aperture-open {
        from {
          clip-path: circle(0.375rem at 50% calc(50% + var(--header-h) / 2));
        }
        to {
          clip-path: circle(71vmax at 50% calc(50% + var(--header-h) / 2));
        }
      }
      @keyframes aperture-reveal {
        from {
          clip-path: circle(0.375rem at 50% var(--ap-cy));
        }
        to {
          clip-path: circle(71vmax at 50% var(--ap-cy));
        }
      }
      @keyframes aperture-dot {
        from {
          opacity: 0;
          scale: 0.4;
        }
      }
    }
  }
</style>
