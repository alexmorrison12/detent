---
/**
 * The instrument stage: the page's one live dial, wrapped in an engraved
 * scale that re-engraves itself for the active feel profile, plus a mono
 * readout. Sticky across hero → feel → mechanism → context, so the page runs
 * a single WebGL context for the whole night chapter.
 *
 * The scale is engraved, not lit: at rest only the detent under the tally
 * pointer glows. Turning the knob lights each detent it crosses and lets it
 * fade, so the ring records the gesture (see paintRing in instrument.ts).
 *
 * Two layouts (the queries are repeated in Instrument.astro and instrument.ts):
 *   side   ≥ 64rem, or a landscape phone: text left, stage pinned right.
 *   stack  portrait phones and tablets: the stage docks under the header and,
 *          as the hero scrolls away, compacts to a small dial and one readout
 *          row so the demos it drives stay on screen (--dock-t, instrument.ts).
 *          Only where there is room (≥ 34rem tall): shorter screens, and pages
 *          zoomed to 300–400%, get a stage that scrolls with the page. While
 *          the mechanism is taken apart the docked dial grows back to full
 *          size (flow unchanged) and a caption under it names the part.
 *
 * −/+ steppers beside the dial turn it one detent per tap: a single-pointer
 * alternative to dragging (WCAG 2.5.7) that stays with the dial when it docks.
 */
import DialStage from '@/components/dial/DialStage.astro';
import { PROFILES, byProfile } from '@/data/product';

const polar = (deg: number, r: number): [number, number] => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [r * Math.cos(a), r * Math.sin(a)];
};
const f = (n: number) => (Math.abs(n) < 1e-9 ? '0' : n.toFixed(2).replace(/\.?0+$/, ''));
const tick = (deg: number, r0: number, r1: number) => {
  const [x1, y1] = polar(deg, r0);
  const [x2, y2] = polar(deg, r1);
  return `M${f(x1)} ${f(y1)}L${f(x2)} ${f(y2)}`;
};
const arc = (from: number, to: number, r: number) => {
  const [x1, y1] = polar(from, r);
  const [x2, y2] = polar(to, r);
  const large = to - from > 180 ? 1 : 0;
  return `M${f(x1)} ${f(y1)}A${r} ${r} 0 ${large} 1 ${f(x2)} ${f(y2)}`;
};

// Fixed bezel: a fine 10° scale, a long mark at each quarter.
let bezelMinor = '';
let bezelMajor = '';
for (let i = 0; i < 36; i++) {
  const deg = i * 10;
  if (deg % 90 === 0) bezelMajor += tick(deg, 114, 121);
  else bezelMinor += tick(deg, 117, 120);
}
// 0 and 180 centre on their quarter mark; 90 and 270 read outward from it,
// the same clearance away, so a three-digit label never runs into its tick.
const numerals = [0, 90, 180, 270].map((deg) => {
  const side = deg === 90 ? 1 : deg === 270 ? -1 : 0;
  const [x, y] = side ? [side * 124.5, 0] : polar(deg, 127);
  const anchor = side > 0 ? 'start' : side < 0 ? 'end' : 'middle';
  return { deg, x: f(x), y: f(y), anchor };
});

// Per-profile engraving: where this feel has something to say. One element
// per mark so each can light on its own. Detent marks come first, in order,
// so mark i is detent i.
interface Mark {
  d: string;
  deg: number;
  heavy: boolean;
  detent?: number;
}
const rings = PROFILES.map((p) => {
  const ph = p.physics;
  const marks: Mark[] = [];
  let guide = '';
  if (ph.detents > 0) {
    const step = 360 / ph.detents;
    for (let i = 0; i < ph.detents; i++) {
      const deg = i * step;
      const accent = (ph.accents ?? []).some(
        (a) => Math.abs((((deg - a) % 360) + 360) % 360) < 1e-6,
      );
      marks.push({ d: accent ? tick(deg, 95, 110) : tick(deg, 100, 109), deg, heavy: accent, detent: i });
    }
  } else if (ph.accents?.length) {
    for (const a of ph.accents) marks.push({ d: tick(a, 100, 109), deg: a, heavy: false });
  }
  if (ph.stops) {
    guide += arc(ph.stops[0], ph.stops[1], 105);
    for (const s of ph.stops) marks.push({ d: tick(s, 95, 112), deg: s, heavy: true });
    if (ph.spring > 0) marks.push({ d: tick(0, 99, 109), deg: 0, heavy: false });
  }
  if (ph.snaps?.length) {
    for (const s of ph.snaps) marks.push({ d: tick(s, 97, 110), deg: s, heavy: true });
  }
  if (!marks.length && !guide) guide = arc(0, 359.9, 105);
  return { id: p.id, marks, guide };
});

const initial = byProfile('ratchet');

// The still under the knob is the LCP image and loads eagerly, so the browser
// picks its file from `sizes` before layout. The knob is the middle 75% of
// .stage__dial (inset 12.5%), so each entry is 3/4 of that layout's dial size
// in the CSS below (header 4rem; vh stands in for svh, which only rounds up):
//   side             min(column ≈ 45vw, 100svh - header - 16.5rem, 46rem)
//   landscape phone  100svh - header - 7.5rem (always shorter than the column)
//   stack            min(72vw, 34svh, 26rem)
const knobSizes = [
  '(min-width: 64rem) min(34vw, 75vh - 15.375rem, 34.5rem)',
  '(orientation: landscape) and (max-height: 30rem) and (min-width: 40rem) calc(75vh - 8.625rem)',
  'min(54vw, 25.5vh, 19.5rem)',
].join(', ');
---

<div class="stage" data-stage data-profile={initial.id}>
  <div class="stage__dial">
    <svg class="scale" viewBox="-130 -130 260 260" aria-hidden="true" focusable="false">
      <path class="scale__minor" d={bezelMinor}></path>
      <path class="scale__major" d={bezelMajor}></path>
      {numerals.map((n) => (
        <text class="scale__num" x={n.x} y={n.y} text-anchor={n.anchor} dominant-baseline="central">
          {n.deg}
        </text>
      ))}
      {rings.map((r) => (
        <g class={`ring ring--${r.id}`} data-ring={r.id} style={`--ring-c: var(--feel-${r.id})`}>
          {r.guide && <path class="ring__guide" d={r.guide} />}
          {r.marks.map((m) => (
            <path
              class:list={['ring__mark', { 'ring__mark--heavy': m.heavy }]}
              d={m.d}
              data-deg={f(m.deg)}
              data-detent={m.detent}
            />
          ))}
        </g>
      ))}
      <g class="scale__marker" data-marker>
        <path d="M0 -112.5L-4.6 -122L4.6 -122Z"></path>
      </g>
    </svg>

    <div class="stage__knob">
      <DialStage
        id="home-dial"
        interactive
        steppers
        priority
        finish="graphite"
        profile={initial.id}
        camera="hero"
        label="Detent One. Drag it in a circle, or use the arrow keys, to turn it."
        sizes={knobSizes}
      />
      <p class="stage__callout" data-callout aria-hidden="true">
        <span class="stage__callout-name" data-callout-name></span>
        <span class="stage__callout-figure readout" data-callout-figure></span>
      </p>
    </div>
  </div>

  <div class="stage__meta">
    <p class="stage__hint" data-hint>
      <span class="stage__hint-fine">Drag it around, or tab to it and use the arrow keys.</span>
      <span class="stage__hint-coarse">Drag the knob in a circle, or tap − and +.</span>
    </p>
    <button class="sound-chip" type="button" data-sound-chip aria-pressed="false">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
        <path
          class="sound-chip__wave"
          d="M15.2 9.2a4 4 0 0 1 0 5.6M17.8 6.6a7.6 7.6 0 0 1 0 10.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        ></path>
      </svg>
      <span class="sound-chip__label" data-sound-label>Hear the detents?</span>
    </button>
  </div>

  <dl class="stage__readout" aria-label="Dial readout">
    <div>
      <dt>Angle</dt>
      <dd class="readout" data-ro-angle>
        +000.0°
      </dd>
    </div>
    <div>
      <dt data-ro-detent-label>Detent</dt>
      <dd class="readout" data-ro-detent>
        00 / {initial.physics.detents}
      </dd>
    </div>
    <div>
      <dt>Profile</dt>
      <dd class="stage__profile" data-ro-profile>
        {initial.name}
      </dd>
    </div>
    <div class="stage__ro-width">
      <dt>Type width</dt>
      <dd class="readout" data-ro-width>
        125%
      </dd>
    </div>
  </dl>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <span class="stage__scrim" aria-hidden="true"></span>
</div>

<style>
  /* 0 → 1 while the mechanism scene has the dial apart (stack layout). */
  @property --stage-mech {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* --dial-full and --dock-dial (the stack layout's full and docked dial)
     come from Instrument.astro, which sizes the chapter gaps around them. */
  .stage {
    position: sticky;
    inset-block-start: var(--header-h);
    z-index: var(--z-raised);
    align-self: start;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-s);
    /* Full-bleed on phones so nothing peeks past the docked stage in the gutters. */
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-xs) var(--gutter) var(--space-s);
    background-color: var(--instrument-bg, var(--bg));
    transition: background-color var(--dur-4) var(--ease-out);
  }
  /* While docked on phones, content sliding under the stage fades rather
     than cuts. Only when actually stuck (scroll-state queries); elsewhere a
     clean edge, so the scrim never dims the CTA below an undocked stage. */
  .stage__scrim {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    block-size: var(--space-m);
    background: linear-gradient(var(--instrument-bg, var(--bg)), transparent);
    pointer-events: none;
  }
  @supports (container-type: scroll-state) {
    .stage {
      container-type: scroll-state;
    }
    @container scroll-state(stuck: top) {
      .stage__scrim {
        display: block;
      }
    }
  }

  .stage__dial {
    position: relative;
    inline-size: min(72vw, 34svh, 26rem);
    aspect-ratio: 1;
  }

  .scale {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .scale__minor {
    stroke: var(--ink-faint);
    stroke-opacity: 0.5;
    stroke-width: 0.6;
  }
  .scale__major {
    stroke: var(--ink-muted);
    stroke-width: 1.1;
  }
  .scale__num {
    fill: var(--ink-muted);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.04em;
  }
  .ring {
    display: none;
  }
  .stage[data-profile='ratchet'] .ring--ratchet,
  .stage[data-profile='fluid'] .ring--fluid,
  .stage[data-profile='spring'] .ring--spring,
  .stage[data-profile='clock'] .ring--clock,
  .stage[data-profile='wall'] .ring--wall,
  .stage[data-profile='magnet'] .ring--magnet {
    display: inline;
  }
  .ring__guide {
    stroke: var(--ring-c);
    stroke-width: 0.8;
    stroke-opacity: 0.45;
  }
  /* Engraved, not lit: the feel color is reserved for the mark under the
     pointer and the ones the knob just crossed, which fade back. */
  .ring__mark {
    stroke: var(--ink-faint);
    stroke-opacity: 0.6;
    stroke-width: 1.3;
    transition:
      stroke var(--dur-4) var(--ease-out),
      stroke-opacity var(--dur-4) var(--ease-out);
  }
  .ring__mark--heavy {
    stroke: color-mix(in oklch, var(--ring-c) 45%, var(--ink-faint));
    stroke-opacity: 0.9;
    stroke-width: 3;
  }
  .ring__mark[data-lit] {
    stroke: var(--ring-c);
    stroke-opacity: 1;
    transition-duration: 0s;
  }
  .scale__marker {
    fill: var(--accent);
    stroke: none;
  }
  .scale__marker path {
    transition: transform var(--dur-1) var(--ease-out);
    transform-origin: 0 -117px;
  }
  .stage[data-ticked] .scale__marker path {
    transform: scale(1.35);
    transition-duration: 40ms;
  }

  .stage__knob {
    position: absolute;
    inset: 12.5%;
  }
  .stage__knob :global(detent-dial:focus-visible) {
    border-radius: 50%;
    outline-offset: 6px;
  }

  /* −/+ (DialStage steppers): on the 3 and 9 o'clock line, just clear of the
     tick ring. The knob box is the dial's middle 75%, so the ring (radius
     0.465 of the dial) reaches 12% of the knob past its edge. */
  .stage__knob :global(.dial-stage__steppers) {
    position: absolute;
    inset-inline: calc(-12% - 3rem);
    inset-block-start: calc(50% - 1.375rem);
    justify-content: space-between;
    pointer-events: none;
    transition:
      opacity var(--dur-3) var(--ease-out),
      visibility var(--dur-3);
  }
  .stage__knob :global(.dial-step) {
    pointer-events: auto;
    background-color: var(--instrument-bg, var(--bg));
  }
  /* The 90 and 270 numerals sit on that line from 40rem up: clear them too. */
  @media (min-width: 40rem) {
    .stage__knob :global(.dial-stage__steppers) {
      inset-inline: calc(-22% - 3rem);
    }
  }

  /* Taking it apart: the scale belongs to the assembled knob, so it steps
     back (with the steppers) and a callout names the part in focus. */
  :global([data-instrument][data-scene='mech']) .scale {
    opacity: 0;
  }
  :global([data-instrument][data-scene='mech']) .stage__knob :global(.dial-stage__steppers) {
    opacity: 0;
    visibility: hidden;
  }
  .stage__callout {
    display: none;
    align-items: baseline;
    gap: 0.6em;
    margin: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .stage__callout-name,
  .stage__callout-figure {
    white-space: nowrap;
  }
  .stage__callout-name {
    font-weight: 680;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
  }
  .stage__callout-figure {
    color: var(--ink-muted);
  }
  :global([data-instrument][data-scene='mech']) .stage__callout[data-on] {
    opacity: 1;
  }

  .stage__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: calc(-1 * var(--space-2xs));
  }
  .stage__hint {
    text-align: center;
    font-size: var(--step--1);
    font-stretch: var(--stretch-ui);
    color: var(--ink-muted);
    pointer-events: none;
  }
  .stage__hint-coarse {
    display: none;
  }
  @media (pointer: coarse) {
    .stage__hint-fine {
      display: none;
    }
    .stage__hint-coarse {
      display: inline;
    }
  }
  :global(html:not([data-js])) .stage__meta {
    display: none;
  }
  /* Once the knob has been turned the hint has done its job. */
  :global([data-instrument][data-touched]) .stage__hint,
  :global([data-instrument][data-scene='mech']) .stage__hint {
    display: none;
  }

  .sound-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    padding: 0.4em 0.95em;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    font-size: var(--step--1);
    font-weight: 600;
    font-stretch: var(--stretch-ui);
    white-space: nowrap;
    color: var(--ink);
    transition:
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }
  @media (hover: hover) {
    .sound-chip:hover {
      border-color: var(--ink);
    }
  }
  .sound-chip:active {
    transform: translateY(1px);
  }
  .sound-chip__wave {
    opacity: 0.35;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .sound-chip[aria-pressed='true'] {
    border-color: color-mix(in oklch, var(--accent) 60%, transparent);
    color: var(--ink-strong);
  }
  .sound-chip[aria-pressed='true'] .sound-chip__wave {
    opacity: 1;
    stroke: var(--accent-text);
  }

  .stage__readout {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: center;
    gap: var(--space-2xs) clamp(0.9rem, 3vw, 2.25rem);
    margin: 0;
  }
  .stage__readout > div {
    display: grid;
    gap: 0.1rem;
  }
  .stage__readout dt {
    font-size: var(--step--2);
    font-weight: 560;
    font-stretch: var(--stretch-ui);
    color: var(--ink-muted);
  }
  .stage__readout dd {
    margin: 0;
    color: var(--ink-strong);
    white-space: nowrap;
  }
  .stage__profile {
    font-size: var(--step--1);
    font-weight: 650;
    font-stretch: var(--stretch-ui);
  }
  [data-ro-angle] {
    min-inline-size: 7.2ch;
  }

  @media (max-width: 22.5rem) {
    .stage__ro-width {
      display: none;
    }
    .stage__readout {
      grid-template-columns: repeat(3, auto);
    }
    /* Icon only: the label stays as the button's name. */
    .sound-chip {
      padding-inline: 0;
    }
    .sound-chip__label {
      position: absolute;
      clip-path: inset(50%);
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
    }
  }

  @media (max-width: 40rem) {
    .scale__num {
      display: none;
    }
    .stage__hint {
      font-size: var(--step--2);
    }
  }

  /* ---- Stack layout: docks under the header, compacts as you scroll ---
     instrument.ts sets --dock-t from 0 (just stuck) to 1 (compact) as the
     hero scrolls away, so the stage shrinks with the scroll instead of
     jumping; data-docking / data-docked mark the in-between and the end.
     Spacing lives on the children so nothing snaps when a row goes away. */
  @media (max-width: 63.99rem) and (orientation: portrait),
    (max-width: 63.99rem) and (min-height: 30.01rem),
    (max-width: 39.99rem) {
    .stage {
      --t: var(--dock-t, 0);
      /* Taking it apart needs the full-size dial back. It grows over the
         content below (the negative margin keeps the flow, and so every
         scene boundary, exactly where it was: no scroll feedback). */
      --grow: calc((var(--dial-full) - var(--dock-dial)) * var(--t) * var(--stage-mech));
      gap: 0;
      margin-block-end: calc(-1 * var(--grow));
      padding-block: calc(var(--space-xs) - (var(--space-xs) - var(--space-2xs)) * var(--t))
        var(--space-xs);
    }
    :global([data-instrument][data-scene='mech']) .stage {
      --stage-mech: 1;
    }
    .stage__dial {
      inline-size: calc(
        var(--dial-full) + (var(--dock-dial) - var(--dial-full)) * var(--t) + var(--grow)
      );
    }
    /* Too short to dock (small landscape phones, 300–400% zoom): the stage
       scrolls with the page instead of covering it (WCAG 1.4.10, 2.4.11). */
    @media (max-height: 33.99rem) {
      .stage {
        position: relative;
        inset-block-start: auto;
      }
    }
    /* The part in focus, captioned under the dial where the readout sits
       (the readout keeps its space, so nothing moves). */
    .stage__callout {
      position: absolute;
      display: flex;
      inset-inline-start: 50%;
      inset-block-start: calc(100% + 100% / 6 + var(--space-2xs));
      translate: -50% 0;
    }
    .stage__callout-name {
      font-size: var(--step--1);
    }
    .stage__callout-figure {
      font-size: var(--step--1);
    }
    :global([data-instrument][data-scene='mech']) .stage__readout {
      visibility: hidden;
    }
    .stage__meta {
      margin-block-start: calc(var(--space-xs) * (1 - var(--t)));
      max-block-size: calc(3rem * (1 - var(--t)));
      opacity: calc(1 - 2 * var(--t));
    }
    .stage[data-docking] .stage__meta {
      overflow: clip;
    }
    .stage__readout {
      margin-block-start: calc(var(--space-s) - (var(--space-s) - var(--space-2xs)) * var(--t));
    }
    .stage[data-docked] .scale__num,
    .stage[data-docked] .stage__meta,
    .stage[data-docked] .stage__ro-width {
      display: none;
    }
    .stage[data-docked] .stage__readout {
      grid-template-columns: repeat(3, auto);
      column-gap: var(--space-l);
    }
    .stage[data-docked] .stage__readout > div {
      gap: 0;
    }
    .stage[data-docked] .stage__readout dd,
    .stage[data-docked] .stage__profile {
      font-size: var(--step--2);
    }
  }
  /* Phones: until the knob moves, the readout would only print zeros, so it
     waits for the first turn, or unfolds as the stage docks. */
  @media (max-width: 39.99rem) {
    :global([data-instrument]:not([data-touched])) .stage__readout {
      max-block-size: calc(3rem * var(--t));
      margin-block-start: calc(var(--space-2xs) * var(--t));
      opacity: var(--t);
      overflow: clip;
    }
  }

  /* ---- Side layout: text left, stage pinned right ---------------------- */
  @media (min-width: 64rem), (orientation: landscape) and (max-height: 30rem) and (min-width: 40rem) {
    .stage {
      block-size: calc(100svh - var(--header-h));
      align-content: center;
      gap: var(--space-m);
      margin-inline: 0;
      padding-block: var(--space-l);
      padding-inline: 0 var(--gutter);
      background-color: transparent;
    }
    .stage__scrim {
      display: none !important;
    }
    /* 16.5rem leaves room for the hint row and readout, and keeps the readout
       clear of the fold under the announcement bar on the first screen. */
    .stage__dial {
      inline-size: min(100%, calc(100svh - var(--header-h) - 16.5rem), 46rem);
    }

    /* No room beside the dial in this column: the steppers take the 4:30
       and 7:30 shoulders, just outside the ring (radius 0.465 of the dial =
       0.62 of the knob; 4px gap, 22px button radius, along the diagonal). */
    .stage__knob :global(.dial-stage__steppers) {
      inset-inline: calc(6.2% - 2.525rem);
      inset-block-start: calc(93.8% - 0.225rem);
    }

    /* Pinned to the active part on the model; instrument.ts caps its width
