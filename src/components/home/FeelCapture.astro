---
/**
 * Engagement-triggered, NON-modal capture. Server-rendered hidden; revealed by
 * src/scripts/home/capture.ts after the third profile change, at most once
 * per session, and suppressed for 30 days after a dismissal. Never an overlay.
 * Live phase swaps it for a one-line "Get launch news" form.
 */
const demo = !import.meta.env.PUBLIC_WAITLIST_ENDPOINT;
const SEGMENTS = [
  { id: 'editing', label: 'Editing' },
  { id: 'music', label: 'Music' },
  { id: 'design', label: 'Design & 3D' },
  { id: 'code', label: 'Code' },
  { id: 'streaming', label: 'Streaming' },
] as const;
const note = demo
  ? 'Concept demo: your email is saved in this browser only. Nothing is sent anywhere.'
  : 'Launch milestones only. Every email has a one-click unsubscribe.';
---

<div
  class="capture"
  data-capture
  data-phase-only="tease waitlist reserve launch"
  role="region"
  aria-labelledby="capture-q"
  hidden
>
  <button class="capture__close" type="button" data-capture-close aria-label="Dismiss the sign-up">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      ></path>
    </svg>
  </button>

  <div class="capture__step" data-step="segment">
    <p class="capture__title" id="capture-q">
      Three feels in. Want the real one?
    </p>
    <p class="capture__sub" id="capture-sub">
      One tap first: what would you turn it for?
    </p>
    <div class="capture__segments" role="group" aria-labelledby="capture-sub">
      {SEGMENTS.map((s) => (
        <button class="capture__seg" type="button" data-segment={s.id}>
          {s.label}
        </button>
      ))}
    </div>
  </div>

  <form class="capture__step" data-step="email" novalidate hidden>
    <label class="capture__title" for="capture-email">
      Your email. We write at launch milestones and nothing else.
    </label>
    <div class="capture__row">
      <input
        class="input capture__input"
        id="capture-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder="you@studio.com"
        aria-describedby="capture-error capture-note"
      />
      <button class="btn btn--primary" type="submit">
        Join the list
      </button>
    </div>
    <p class="capture__error" id="capture-error" data-capture-error role="alert"></p>
    <p class="concept-note" id="capture-note">
      {note}
    </p>
    <button class="capture__back" type="button" data-capture-back>
      Change my answer
    </button>
  </form>

  <div class="capture__step" data-step="done" role="status" hidden>
    <p class="capture__title">You’re on the list.</p>
    <p class="capture__sub">
      {demo
        ? 'Saved in this browser. In a real launch, a confirmation email would be on its way.'
        : 'Check your inbox to confirm.'}
      <a class="link-arrow" data-capture-next href="#">
        See what it does for you
      </a>
    </p>
  </div>
</div>

<form class="capture capture--news" data-capture data-phase-only="live" novalidate hidden>
  <button
    class="capture__close"
    type="button"
    data-capture-close
    aria-label="Dismiss launch news sign-up"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      ></path>
    </svg>
  </button>
  <div class="capture__step" data-step="email">
    <label class="capture__title" for="news-email">
      New feels and firmware, a few emails a year.
    </label>
    <div class="capture__row">
      <input
        class="input capture__input"
        id="news-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder="you@studio.com"
        aria-describedby="news-error news-note"
      />
      <button class="btn btn--primary" type="submit">
        Get launch news
      </button>
    </div>
    <p class="capture__error" id="news-error" data-capture-error role="alert"></p>
    <p class="concept-note" id="news-note">
      {note}
    </p>
  </div>
  <div class="capture__step" data-step="done" role="status" hidden>
    <p class="capture__title">Done. You’ll hear about the next one.</p>
  </div>
</form>

<style>
  .capture {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-m);
    padding-inline-end: calc(var(--space-m) + 2.5rem);
    border-radius: var(--r-l);
    border: 1px solid var(--line-strong);
    background: color-mix(in oklch, var(--instrument-bg, var(--bg)) 80%, var(--graphite-800));
  }
  .capture[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .capture {
      transition:
        opacity var(--dur-3) var(--ease-out),
        translate var(--dur-3) var(--ease-out);
    }
    @starting-style {
      .capture {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }
  }
  .capture__close {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    color: var(--ink-muted);
  }
  @media (hover: hover) {
    .capture__close:hover {
      color: var(--ink-strong);
      background: var(--surface);
    }
  }
  .capture__step {
    display: grid;
    gap: var(--space-xs);
  }
  .capture__step[hidden] {
    display: none;
  }
  .capture__title {
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: var(--stretch-ui);
    line-height: 1.25;
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .capture__sub {
    color: var(--ink-muted);
  }
  .capture__sub .link-arrow {
    margin-inline-start: 0.35em;
  }
  .capture__segments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .capture__seg {
    min-block-size: 2.75rem;
    padding: 0.5em 1.1em;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    font-weight: 600;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  @media (hover: hover) {
    .capture__seg:hover {
      border-color: var(--ink);
      background: var(--surface);
    }
  }
  .capture__seg:active {
    transform: translateY(1px);
  }
  .capture__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .capture__input {
    flex: 1 1 14rem;
    min-inline-size: 0;
  }
  .capture__error:empty {
    display: none;
  }
  .capture__error {
    color: var(--tally-hot);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .capture__back {
    justify-self: start;
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    min-block-size: 2.75rem;
  }
  @media (hover: hover) {
    .capture__back:hover {
      color: var(--ink-strong);
    }
  }
</style>
