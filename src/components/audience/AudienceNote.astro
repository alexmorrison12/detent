---
/**
 * The matching early-tester note. Testers are illustrative personas (Detent
 * is a concept), and the page says so right under the quote.
 */
import { TESTER_NOTES, byProfile, type ProfileId } from '@/data/product';

interface Props {
  profile: ProfileId;
}
const { profile } = Astro.props;
const note = TESTER_NOTES.find((n) => n.profile === profile) ?? TESTER_NOTES[0]!;
const p = byProfile(note.profile);
---

<section
  class="note section"
  aria-label="Early tester note"
  style={`--feel: var(--feel-${note.profile})`}
>
  <figure class="container note__fig">
    <blockquote class="note__quote">
      <p>“{note.quote}”</p>
    </blockquote>
    <figcaption class="note__who">
      <span class="note__name">{note.name}</span>
      <span class="note__role">{note.role}</span>
      <span class="note__feel">
        <span class="note__ring" aria-hidden="true"></span>Tested with {p.name}
      </span>
    </figcaption>
    <p class="note__disclosure">
      Illustrative note from an early-tester persona. Detent is a concept product and has no
      customers yet.
    </p>
  </figure>
</section>

<style>
  .note {
    border-block: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .note__fig {
    display: grid;
    gap: var(--space-l);
    margin-block: 0;
  }
  @media (min-width: 60rem) {
    .note__fig {
      grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
      align-items: end;
      column-gap: var(--space-2xl);
    }
    .note__disclosure {
      grid-column: 1 / -1;
    }
  }
  .note__quote p {
    font-size: var(--step-4);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
    text-wrap: balance;
    max-inline-size: 28ch;
  }
  @media (min-width: 48rem) {
    .note__quote p {
      text-indent: -0.42em;
    }
  }
  .note__who {
    display: grid;
    gap: 0.2rem;
    padding-block-start: var(--space-s);
    border-top: 2px solid var(--feel);
  }
  .note__name {
    font-weight: 680;
    color: var(--ink-strong);
    font-stretch: var(--stretch-ui);
  }
  .note__role {
    color: var(--ink-muted);
  }
  .note__feel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink);
  }
  .note__ring {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--feel);
  }
  .note__disclosure {
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
</style>
