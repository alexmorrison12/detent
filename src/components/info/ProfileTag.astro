---
/**
 * A feel profile's color dot plus its name. Color is never the only signal:
 * the name is always printed next to the dot.
 */
import { byProfile, type ProfileId } from '@/data/product';

interface Props {
  profile: ProfileId;
  size?: 's' | 'm';
  class?: string;
}
const { profile, size = 's', class: className } = Astro.props;
const p = byProfile(profile);
---

<span class:list={['profile-tag', `profile-tag--${size}`, className]} style={`--feel: var(--feel-${p.id})`} data-profile={p.id}>
  <span class="profile-tag__dot" aria-hidden="true"></span>
  <span class="profile-tag__name">{p.name}</span>
</span>

<style>
  .profile-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
    white-space: nowrap;
  }
  .profile-tag--s {
    font-size: var(--step--1);
  }
  .profile-tag__dot {
    inline-size: 0.7em;
    block-size: 0.7em;
    border-radius: 50%;
    background: var(--feel);
    /* Pale feel colors need an edge on white. */
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / 0.18);
    flex: none;
  }
</style>
