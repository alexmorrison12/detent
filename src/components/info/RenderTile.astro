---
/**
 * A product render with a download link. The tile shows the render through
 * DialStill (the same hero file, as responsive AVIF/WebP from 240 to 1600 w),
 * so a 320px thumbnail pulls a thumbnail-sized file; only the download link
 * points at the full 1600px WebP.
 */
import DialStill from '@/components/dial/DialStill.astro';
import type { FinishId } from '@/data/product';
import { url } from '@/lib/url';

interface Props {
  finish: FinishId;
  name: string;
  file: string;
  note?: string;
  /** Rendered width of the tile, for the still's srcset. */
  sizes?: string;
}
const { finish, name, file, note, sizes = '(min-width: 88rem) 20rem, (min-width: 64rem) 22vw, 46vw' } = Astro.props;
---

<figure class="render">
  <div class="render__frame">
    <DialStill finish={finish} view="hero" alt={`Detent One in ${name}`} sizes={sizes} />
  </div>
  <figcaption class="render__cap">
    <span class="render__name">{name}{note && <span class="render__note"> · {note}</span>}</span>
    <a href={url(file)} download class="render__dl" data-track="press_download" data-track-asset={`render-${finish}`}>
      WebP<span class="visually-hidden">, Detent One in {name}</span>
    </a>
  </figcaption>
</figure>

<style>
  .render {
    display: grid;
    gap: var(--space-xs);
  }
  .render__frame {
    aspect-ratio: 1;
    border-radius: var(--r-m);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .render__cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step--1);
  }
  .render__name {
    font-weight: 640;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
  }
  .render__note {
    font-weight: 400;
    color: var(--ink-muted);
  }
  .render__dl {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-weight: 620;
    color: var(--accent-text);
  }
</style>
