---
/**
 * #configure: heading, stage, options and price panel. DOM order is
 * h1 → dial → choices → summary; the grid rearranges it per width:
 *   wide:   stage | head+options | panel   (stage and panel sticky)
 *   tablet: stage | head+options+panel     (stage sticky)
 *   phone:  one column, docked summary bar
 */
import ConfigStage from './ConfigStage.astro';
import ConfigOptions from './ConfigOptions.astro';
import PricePanel from './PricePanel.astro';
import SummaryBar from './SummaryBar.astro';
---

<section id="configure" class="configure" aria-labelledby="configure-title">
  <div class="container configure__grid">
    <header class="configure__head">
      <h1 id="configure-title" class="display configure__title" data-knob-type>
        <span>Build</span>
        <span>yours.</span>
      </h1>
      <p class="configure__lede">
        Pick the edition, the finish and the feel it wakes up in. The build lives in this page’s
        address, so the link is the save button.
      </p>
    </header>
    <div class="configure__stage">
      <ConfigStage />
    </div>
    <div class="configure__options">
      <ConfigOptions />
    </div>
    <div class="configure__panel">
      <PricePanel />
    </div>
  </div>
  <SummaryBar />
</section>

<script>
  import '@/scripts/shop/configurator';
</script>

<style>
  .configure {
    padding-block: var(--space-l) var(--section-y);
  }
  .configure__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr);
  }
  .configure__head {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  .configure__title {
    display: grid;
    font-size: var(--step-5);
    transition: font-stretch var(--dur-1) linear;
  }
  .configure__title span {
    white-space: nowrap;
  }
  .configure__lede {
    color: var(--ink-muted);
    max-width: 42ch;
  }
  .configure__options {
    min-inline-size: 0;
  }

  @media (max-width: 47.99rem) {
    .configure__grid {
      gap: var(--space-l);
    }
    .configure__stage {
      inline-size: min(100%, 26rem);
      justify-self: center;
    }
  }

  @media (min-width: 48rem) {
    .configure__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'stage head'
        'stage options'
        'stage panel';
      column-gap: clamp(var(--space-l), 4vw, var(--space-2xl));
    }
    .configure__head {
      grid-area: head;
    }
    .configure__options {
      grid-area: options;
    }
    .configure__panel {
      grid-area: panel;
    }
    /* Sticky beside the options, sized so the whole dial (readouts included)
       fits between the header and the docked summary bar. */
    .configure__stage {
      grid-area: stage;
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-m));
      align-self: start;
      --stage-fit: calc(100svh - var(--header-h) - var(--space-m) - 15rem);
    }
  }

  @media (min-width: 75rem) {
    .configure__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(18rem, 21.5rem);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'stage head panel'
        'stage options panel';
      column-gap: clamp(var(--space-l), 3vw, var(--space-xl));
    }
    /* No docked bar at this width: less to leave room for. */
    .configure__stage {
      --stage-fit: calc(100svh - var(--header-h) - var(--space-m) - 9rem);
    }
    .configure__panel {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-m));
      align-self: start;
    }
    /* Taller than the viewport (short screens, long builds): the panel
       scrolls inside itself so its last line is always reachable, and its
       lower edge fades while there is more below. */
    .configure__panel > :global(.panel) {
      gap: var(--space-s);
      max-block-size: calc(100svh - var(--header-h) - 2 * var(--space-m));
      overflow-y: auto;
      scrollbar-width: thin;
    }
    @supports (animation-timeline: scroll()) {
      .configure__panel > :global(.panel) {
        -webkit-mask-image: linear-gradient(#000 calc(100% - var(--panel-fade)), transparent);
        mask-image: linear-gradient(#000 calc(100% - var(--panel-fade)), transparent);
        animation: panel-more linear both;
        animation-timeline: scroll(self);
      }
    }
  }
  @property --panel-fade {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  /* Fade only while scrolled short of the end; nothing to scroll, no fade. */
  @keyframes panel-more {
    0%,
    95% {
      --panel-fade: 2.5rem;
    }
    100% {
      --panel-fade: 0px;
    }
  }

  /* Landscape phones and other short screens: nothing fits while stuck, so
     the dial scrolls with the page, sized to fit between the header and the
     docked summary bar once scrolled to. */
  @media (min-width: 48rem) and (max-height: 34rem) {
    .configure__stage,
    .configure__panel {
      position: relative;
      inset-block-start: auto;
    }
    .configure__stage {
      --stage-fit: calc(100svh - var(--header-h) - 5.5rem);
    }
    .configure__panel > :global(.panel) {
      max-block-size: none;
      overflow: visible;
    }
  }

  /* Line items: shared by the panel and the summary sheet, rendered by script. */
  .configure :global(.qlines) {
    display: grid;
    gap: 0.55rem;
    font-size: var(--step--2);
  }
  .configure :global(.ql) {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-s);
    align-items: baseline;
    color: var(--ink);
  }
  .configure :global(.ql__amount) {
    text-align: end;
    color: var(--ink-strong);
    white-space: nowrap;
  }
  .configure :global(.ql--note .ql__amount),
  .configure :global(.ql__qty),
  .configure :global(.ql__detail) {
    color: var(--ink-muted);
  }
  .configure :global(.ql__detail) {
    grid-column: 1 / -1;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .configure__title {
      transition: none;
    }
  }
</style>
