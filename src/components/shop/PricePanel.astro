---
/**
 * "Your build": line items, the phase's price, deposit/balance while
 * reserving, the primary action and the risk reversals. Sticky beside the
 * configurator on wide screens; inline at the end of the form elsewhere
 * (the SummaryBar covers small screens while it is out of view).
 */
import { BUILD_PHASE, LAUNCH } from '@/config/launch';
import { PAYMENT, byEdition, formatUsd } from '@/data/product';
import { REFERRAL, launchPriceEndsLabel } from '@/data/shop';
import { byShips } from '@/data/shop-content';
import { url } from '@/lib/url';
import { DEFAULT_BUILD, buildTitle, hasLaunchPrice, quote, type Build } from '@/scripts/shop/build';
import { quoteLinesHtml } from '@/scripts/shop/render';
import BuildAction from './BuildAction.astro';
import PhaseText from './PhaseText.astro';

interface Props {
  build?: Build;
}
const { build = DEFAULT_BUILD } = Astro.props;
const q = quote(build, BUILD_PHASE);
/** The real end of launch pricing (72 hours, not a week). */
const launchEnds = launchPriceEndsLabel();
const launchEndsShort = launchPriceEndsLabel('short');
const one = byEdition('one');
const founders = byEdition('founders');
/** Which price note shows (the configurator keeps it in step with the build). */
const launchPriced = hasLaunchPrice(build.edition);
const foundersRun = LAUNCH.foundersRun.toLocaleString('en-US');
---

<aside class="panel" id="build-summary" aria-labelledby="build-summary-title" data-panel>
  <header class="panel__head">
    <h2 id="build-summary-title" class="panel__title">
      Your build
    </h2>
    <!-- The build lives in the URL, so its link is the save button: kept
         beside the build's name, where it reads as "this one". -->
    <div class="panel__share">
      <button type="button" class="panel__share-btn" data-copy-build hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>
        Copy link<span class="visually-hidden"> to this build</span>
      </button>
      <button type="button" class="panel__share-btn" data-share-build hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M12 15V4m0 0L8 8m4-4 4 4M6 12v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        Share<span class="visually-hidden"> this build</span>
      </button>
    </div>
    <p class="panel__name" data-build-title>
      {buildTitle(build)}
    </p>
    <p class="panel__share-status" role="status" data-share-status></p>
  </header>

  <ul role="list" class="panel__lines qlines" data-build-lines set:html={quoteLinesHtml(q.lines)} />

  <div class="panel__total">
    <span class="panel__total-label">Total</span>
    <span class="panel__total-value readout">
      <s class="panel__regular" data-build-regular hidden={q.regularTotal <= q.total}>
        <span class="visually-hidden">Regular price </span>
        <span data-build-regular-value>{formatUsd(q.regularTotal)}</span>
      </s>
      <span data-build-total>{formatUsd(q.total)}</span>
    </span>
  </div>

  <div class="panel__notes">
    <!-- The launch price is open to every reservation: no early-spot scarcity (launch.ts). -->
    <p data-phase-only="tease waitlist">
      Every reservation locks the {formatUsd(one.launchPriceUsd)} launch price. {founders.name} is
      always {formatUsd(founders.priceUsd)}.
    </p>
    <!-- Reserve and launch: the note follows the build (configurator.ts). An
         edition with a launch price says what it locks and when it ends; one
         without (Founders) never claims a launch price. -->
    <p data-phase-only="reserve" data-price-note="launch" hidden={!launchPriced}>
      Launch price, locked by your deposit. Orders after {launchEndsShort} pay
      {formatUsd(one.priceUsd)}.
    </p>
    <p data-phase-only="reserve" data-price-note="regular" hidden={launchPriced}>
      {founders.name} is always {formatUsd(founders.priceUsd)}. Your deposit holds one of the
      {foundersRun} numbered units.
    </p>
    <p data-phase-only="launch" data-price-note="launch" hidden={!launchPriced}>
      Launch price until {launchEnds}. {formatUsd(one.priceUsd)} after that.
    </p>
    <p data-phase-only="launch" data-price-note="regular" hidden={launchPriced}>
      {founders.name} is always {formatUsd(founders.priceUsd)}, launch week included.
    </p>
    <!-- Pay over time: the live store only, never beside a deposit (launch plan). -->
    <p class="panel__installments" data-phase-only="live" data-build-installments>
      {PAYMENT.installmentLabel(q.total)}.
    </p>
    <p class="panel__ref" data-ref-note hidden>
      You came in on a friend’s link. When yours ships, you both get the {REFERRAL.profile}
      feel.
    </p>
  </div>

  <dl class="panel__due" data-phase-only="reserve">
    <div>
      <dt>Due today, refundable</dt>
      <dd class="readout" data-build-deposit>
        {formatUsd(q.deposit)}
      </dd>
    </div>
    <div>
      <dt>When your batch ships</dt>
      <dd class="readout" data-build-balance>
        {formatUsd(q.total - q.deposit)}
      </dd>
    </div>
  </dl>

  <p class="panel__held" data-phase-only="reserve" data-held hidden>
    You already hold <span class="readout" data-held-id></span> for <span data-held-build></span>.
    Reserving this build adds another. <a href={url('/l/reserve/')}>See your reservation</a>
  </p>

  <BuildAction placement="panel" />
  <p class="concept-note panel__concept">Concept demo: nothing is charged or sent.</p>

  <!-- The risk reversals as one compact list under the action, with the same
       checks the cart and checkout use. Ordered so the short ones pair up on
       a line in the sticky panel. -->
  <ul role="list" class="panel__facts">
    <li>
      <span>
        Ships with <PhaseText variants={byShips()} />
      </span>
    </li>
    <li>Free tracked shipping</li>
    <li>{PAYMENT.warrantyYears}-year warranty</li>
    <li>{PAYMENT.trialDays}-day trial, free returns</li>
  </ul>
</aside>

<style>
  .panel {
    /* The sticky panel tightens this to fit a laptop screen (ShopConfigurator). */
    --panel-gap: var(--space-m);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--panel-gap);
    padding: var(--space-m);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-l);
    background: var(--bg);
  }
  .panel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem var(--space-s);
  }
  .panel__title {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }
  .panel__name,
  .panel__share-status {
    grid-column: 1 / -1;
  }
  .panel__name {
    font-size: var(--step-1);
    font-weight: 720;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
    line-height: 1.2;
  }

  /* Link actions share the title's line. Their 44px targets reach into the
     panel padding and the name's line instead of pushing both apart. */
  .panel__share {
    display: flex;
    gap: var(--space-s);
    margin-block: -0.7rem;
  }
  .panel__share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: 2.75rem;
    font-size: var(--step--1);
    font-weight: 620;
    font-stretch: var(--stretch-ui);
    color: var(--accent-text);
  }
  @media (hover: hover) {
    .panel__share-btn:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  .panel__share-status {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .panel__share-status:empty {
    display: none;
  }

  .panel__lines {
    padding-block: var(--space-xs);
    border-block: 1px solid var(--line);
  }

  .panel__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }
  .panel__total-label {
    font-weight: 650;
    font-stretch: var(--stretch-ui);
    color: var(--ink-strong);
  }
  .panel__total-value {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums;
  }
  .panel__regular {
    font-size: var(--step-0);
    color: var(--ink-muted);
    font-weight: 400;
  }
  .panel__notes {
    display: grid;
    gap: 0.3rem;
    /* Reads as the total's footnote, whatever the panel gap. */
    margin-block-start: calc(var(--space-3xs) - var(--panel-gap));
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .panel__installments,
  .panel__ref {
    color: var(--ink);
  }
  .panel__held {
    font-size: var(--step--1);
    color: var(--ink);
  }
  .panel__held a {
    color: var(--accent-text);
    font-weight: 600;
  }
  .panel__concept {
    margin-block-start: calc(var(--space-2xs) - var(--panel-gap));
    text-wrap: pretty;
  }

  .panel__due {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--r-m);
    background: var(--bg-raised);
    font-size: var(--step--1);
  }
  .panel__due div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
  }
  .panel__due dt {
    color: var(--ink);
  }
  .panel__due dd {
    color: var(--ink-strong);
  }
  .panel__due div:first-child dd {
    font-weight: 650;
  }

  .panel__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1em;
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink);
  }
  .panel__facts li {
    display: flex;
    gap: 0.45em;
    align-items: baseline;
  }
  .panel__facts li::before {
    content: '';
    flex: none;
    inline-size: 0.75em;
    block-size: 0.4em;
    border-inline-start: 2px solid var(--accent-text);
    border-block-end: 2px solid var(--accent-text);
    rotate: -45deg;
    translate: 0 -0.2em;
  }
</style>
