---
/**
 * A static picture of Detent One: product stills rendered from the live
 * three.js scene by scripts/render-stills.mjs (public/renders/*).
 * AVIF first, WebP fallback, 240/480/800/1600 w, transparent background, square.
 *
 *   <DialStill finish="glacier" view="top" />
 *   <DialStill finish="graphite" view="hero" priority />   // above the fold: eager + fetchpriority=high
 *   <DialStill finish="raw" view="top" sizes="(min-width: 64rem) 7rem, 72px" />
 *
 * Pass `sizes` whenever you know the rendered width. Lazy stills also let the
 * browser measure the real layout width first (sizes="auto"), so a thumbnail
 * never pulls a hero-sized file; an eager (priority) still can't be measured
 * before it loads, so its `sizes` should always be given.
 */
import { byFinish, type FinishId } from '@/data/product';
import { url } from '@/lib/url';

export type StillView = 'hero' | 'top' | 'side' | 'front' | 'exploded' | 'config';

interface Props {
  finish?: FinishId;
  view?: StillView;
  alt?: string;
  priority?: boolean;
  /** Rendered width hint for the browser's srcset choice. */
  sizes?: string;
  class?: string;
}
const {
  finish = 'graphite',
  view = 'hero',
  alt,
  priority = false,
  sizes: sizesProp,
  class: className,
} = Astro.props;
const f = byFinish(finish);
const phrase: Record<StillView, string> = {
  hero: 'three-quarter view from above, display lit',
  config: 'three-quarter view from above and to the right, display lit',
  top: 'seen from directly above, the round display showing the Ratchet feel',
  side: 'in profile: the knurled knob ring on its heavy base',
  front: 'from the front, at desk height',
  exploded:
    'exploded into its parts: glass, display, knob ring, magnet rotor, copper stator, encoder board, battery, base and foot',
};
const label = alt ?? `Detent One in ${f.name}, ${phrase[view]}`;
const WIDTHS = [240, 480, 800, 1600] as const;
const src = (ext: 'avif' | 'webp', w: (typeof WIDTHS)[number]) =>
  url(`/renders/${finish}-${view}${w === 1600 ? '' : `-${w}`}.${ext}`);
const set = (ext: 'avif' | 'webp') => WIDTHS.map((w) => `${src(ext, w)} ${w}w`).join(', ');
const fallbackSizes = sizesProp ?? '(min-width: 64rem) 44vw, 92vw';
// "auto" (lazy images only) = the laid-out width; the list after it is for browsers without it.
const sizes = priority ? fallbackSizes : `auto, ${fallbackSizes}`;
---

<picture class:list={['dial-still', className]}>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={src('webp', 800)}
    width="1600"
    height="1600"
    alt={label}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding={priority ? undefined : 'async'}
  />
</picture>

<style>
  .dial-still {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  .dial-still img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
</style>
