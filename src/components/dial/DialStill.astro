---
/**
 * A static picture of Detent One. SCAFFOLD: draws an SVG illustration.
 * The dial feature replaces this with real renders (public/renders/*),
 * keeping the same props.
 */
import { byFinish, type FinishId } from '@/data/product';

interface Props {
  finish?: FinishId;
  view?: 'hero' | 'top' | 'side' | 'front';
  alt?: string;
  priority?: boolean;
  class?: string;
}
const { finish = 'graphite', view = 'hero', alt, class: className } = Astro.props;
const f = byFinish(finish);
const label = alt ?? `Detent One in ${f.name}, ${view === 'top' ? 'seen from above' : 'three-quarter view'}`;
---

<svg class:list={['dial-still', className]} viewBox="-110 -110 220 220" role="img" aria-label={label}>
  <circle r="92" fill={f.body} opacity="0.55"></circle>
  <circle r="74" fill={f.body}></circle>
  <circle r="52" fill="#0b0a0b"></circle>
  <circle r="46" fill="none" stroke={f.accent} stroke-width="3" opacity="0.8"></circle>
  <line x1="0" y1="-70" x2="0" y2="-58" stroke={f.accent} stroke-width="5" stroke-linecap="round" transform="rotate(35)"></line>
</svg>

<style>
  .dial-still {
    inline-size: 100%;
    block-size: 100%;
  }
</style>
