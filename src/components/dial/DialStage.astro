---
/**
 * The way pages place a Detent dial. Server-renders a product still (so there
 * is an image before JS, for no-JS, and as the LCP candidate), then upgrades
 * to the live <detent-dial> once its engine arrives (a small loader fetches it
 * when the dial nears the viewport after load, or the moment someone reaches
 * for it): SVG when needed, three.js when the dial is in view, the browser is
 * idle and there is a real GPU. Pages never import three.js.
 *
 *   <DialStage interactive finish="graphite" profile="ratchet" priority />
 *   <DialStage camera="exploded" finish="raw" />
 *   <DialStage interactive steppers profile="wall" label="Master volume" />
 *
 * The stage is square by default; give it another aspect-ratio with a class.
 */
import type { FinishId, ProfileId } from '@/data/product';
import type { CameraPreset } from '@/scripts/dial/types';
import DialStill, { type StillView } from './DialStill.astro';

interface Props {
  finish?: FinishId;
  profile?: ProfileId;
  interactive?: boolean;
  camera?: CameraPreset;
  autorotate?: boolean;
  label?: string;
  display?: string;
  /** Small line under `display` on the knob (without it the line is blank while `display` is set). */
  displaySub?: string;
  /** Replaces the profile name line on the knob display; '' hides it (games with a hidden feel). */
  displayName?: string;
  /** Show the still's display as powered off (top camera only), e.g. so a game's hidden feel isn't printed on the still before the live dial takes over. */
  blankDisplay?: boolean;
  quality?: 'auto' | 'low' | 'high';
  /** Eager-load the still (use for the LCP dial above the fold). */
  priority?: boolean;
  id?: string;
  class?: string;
  /** Visible −/+ buttons under the dial: a single-pointer alternative to dragging (WCAG 2.5.7). */
  steppers?: boolean;
  /** No sound and no vibration from this dial (decorative dials, grids). */
  muted?: boolean;
  /** Boot 3D immediately instead of on idle (above-the-fold toys). */
  eager?: boolean;
  /** sizes attribute for the still's srcset: pass the real rendered width (required for `priority`). */
  sizes?: string;
  /** Opt-in cross-document view transition name (must be unique on the page). */
  transitionName?: string;
}
const {
  finish = 'graphite',
  profile = 'ratchet',
  interactive = false,
  camera = 'hero',
  autorotate = false,
  label,
  display,
  displaySub,
  displayName,
  quality = 'auto',
  priority = false,
  id,
  class: className,
  steppers = false,
  blankDisplay = false,
  muted = false,
  eager = false,
  sizes,
  transitionName,
} = Astro.props;

// Every camera has a still framed exactly like the live dial's first frame, so the
// 3D takeover is a crossfade, never a camera move.
const stillView: StillView = camera;
const dialId = id ?? (steppers ? `dial-${Math.random().toString(36).slice(2, 8)}` : undefined);
const style = transitionName ? `view-transition-name: ${transitionName}` : undefined;
---

{steppers ? (
  <div class="dial-stage-wrap">
    <detent-dial
      id={dialId}
      class:list={['dial-stage', className]}
      style={style}
      finish={finish}
      profile={profile}
      camera={camera}
      quality={quality}
      interactive={interactive || undefined}
      autorotate={autorotate || undefined}
      muted={muted || undefined}
      loading={eager ? 'eager' : undefined}
      label={label}
      display={display}
      display-sub={displaySub}
      display-name={displayName}
    >
      <div data-dial-fallback data-camera={stillView} data-blank-display={blankDisplay && stillView === 'top' ? '' : undefined} class="dial-stage__fallback">
        <DialStill finish={finish} view={stillView} priority={priority} sizes={sizes} />
      </div>
    </detent-dial>
    <div class="dial-stage__steppers">
      <button
        class="dial-step"
        type="button"
        data-dial-step="-1"
        aria-controls={dialId}
        aria-label="Turn back one step"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <button
        class="dial-step"
        type="button"
        data-dial-step="1"
        aria-controls={dialId}
        aria-label="Turn forward one step"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 12h12M12 6v12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
) : (
  <detent-dial
    id={dialId}
    class:list={['dial-stage', className]}
    style={style}
    finish={finish}
    profile={profile}
    camera={camera}
    quality={quality}
    interactive={interactive || undefined}
    autorotate={autorotate || undefined}
    muted={muted || undefined}
    loading={eager ? 'eager' : undefined}
    label={label}
    display={display}
    display-sub={displaySub}
    display-name={displayName}
  >
    <div data-dial-fallback data-camera={stillView} data-blank-display={blankDisplay && stillView === 'top' ? '' : undefined} class="dial-stage__fallback">
      <DialStill finish={finish} view={stillView} priority={priority} sizes={sizes} />
    </div>
  </detent-dial>
)}

<script>
  // A tiny loader: the engine arrives when a dial nears the viewport (after load,
  // on idle) or the moment someone reaches for one. The still covers until then.
  import { watchDials } from '@/scripts/dial/loader';
  watchDials();
</script>

<style>
  .dial-stage {
    display: block;
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1;
  }
  .dial-stage__fallback {
    position: absolute;
    inset: 0;
  }
  .dial-stage-wrap {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
  }
  .dial-stage__steppers {
    display: flex;
    gap: var(--space-xs);
  }
  :global(html:not([data-js])) .dial-stage__steppers {
    display: none;
  }
  .dial-step {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink-strong);
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }
  @media (hover: hover) {
    .dial-step:hover {
      border-color: var(--ink);
    }
  }
  .dial-step:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .dial-step:active {
      transform: none;
    }
  }
  /* A powered-off display on the top-view still (the glass face sits at the
     centre, ~39% of the frame). The live dial draws its own face on top. */
  .dial-stage__fallback[data-blank-display]::after {
    content: '';
    position: absolute;
    inset: 30.5%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, oklch(0.16 0.004 355), oklch(0.08 0.003 355) 70%);
    pointer-events: none;
  }
</style>
