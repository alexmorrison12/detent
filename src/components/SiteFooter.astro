---
import { FOOTER_NAV, SITE } from '@/config/site';
import { url } from '@/lib/url';
import Logo from './Logo.astro';

interface Props {
  chrome?: 'full' | 'minimal';
}
const { chrome = 'full' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-world="night">
  <div class="container">
    {
      chrome === 'full' && (
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <Logo angle={-35} />
            <p class="muted">{SITE.tagline}</p>
          </div>
          <nav class="site-footer__nav" aria-label="Footer">
            {FOOTER_NAV.map((col) => (
              <div>
                <h2 class="site-footer__title">{col.title}</h2>
                <ul role="list">
                  {col.items.map((item) => (
                    <li>
                      <a href={url(item.href)}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      )
    }
    <div class="site-footer__bottom">
      <p class="site-footer__concept">{SITE.conceptNotice}</p>
      <p class="muted">
        © {year}
        {SITE.legalName}.
        {
          chrome === 'minimal' && (
            <>
              <a href={url('/legal/privacy/')}>Privacy</a> · <a href={url('/legal/terms/')}>Terms</a> ·{' '}
              <a href={url('/')}>detent.one</a>
            </>
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) 3fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }
  .site-footer__brand {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-l);
  }
  .site-footer__title {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink-strong);
    margin-bottom: var(--space-xs);
  }
  .site-footer__nav ul {
    display: grid;
    gap: 0.35rem;
  }
  .site-footer__nav a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .site-footer__nav a:hover {
      color: var(--ink-strong);
    }
  }
  /* Under a finger every link is a full 44px row. */
  @media (pointer: coarse) {
    .site-footer__nav ul {
      gap: 0;
    }
    .site-footer__nav a {
      display: inline-block;
      padding-block: 0.7rem;
    }
    .site-footer__title {
      margin-bottom: 0;
    }
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .site-footer__concept {
    max-width: 70ch;
    color: var(--ink-muted);
  }
  @media (max-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
